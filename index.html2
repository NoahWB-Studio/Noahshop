<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ShopForge</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@300;400;500&family=Oswald:wght@300;400;500&family=Cormorant+Garamond:ital,wght@0,300;0,600;1,300&family=Bebas+Neue&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#FFFFFF;--surface:#F5F5F5;--border:#E0E0E0;--text:#0A0A0A;--muted:#6B6B6B;
  --accent:#0A0A0A;--danger:#C0392B;--success:#2D7A2D;
  --btn-bg:#0A0A0A;--btn-text:#FFFFFF;--cart-bg:#F0F0F0;
  --radius:6px;--radius-lg:10px;--radius-xl:16px;
  --font-heading:'Playfair Display',serif;--font-body:'DM Sans',sans-serif;
}
body{font-family:var(--font-body);background:var(--bg);color:var(--text);min-height:100vh;font-size:15px}
h1,h2,h3,.serif{font-family:var(--font-heading)}
#topbar{background:var(--accent);color:#fff;text-align:center;font-size:12px;padding:8px;letter-spacing:.06em}
#navbar{background:var(--bg);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 1rem;height:64px;position:sticky;top:0;z-index:100}
.nav-logo{font-family:var(--font-heading);font-size:24px;font-weight:700;color:var(--text);cursor:pointer;letter-spacing:-.02em}
.nav-links{display:flex;gap:1.5rem;align-items:center}
.nav-link{font-size:13px;color:var(--muted);cursor:pointer;transition:color .2s;border:none;background:none;font-family:inherit;letter-spacing:.04em;text-transform:uppercase}
.nav-link:hover{color:var(--text)}
.nav-actions{display:flex;gap:.5rem;align-items:center}
.icon-btn{background:none;border:none;cursor:pointer;color:var(--text);position:relative;padding:8px 14px;display:flex;align-items:center;gap:7px;font-family:inherit;font-size:13px;font-weight:500;border-radius:var(--radius);transition:background .15s;border:1.5px solid var(--border)}
.icon-btn:hover{background:var(--surface);border-color:var(--text)}
.icon-btn i{font-size:20px}
.icon-btn-label{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
.cart-badge{position:absolute;top:-4px;right:-4px;background:var(--danger);color:#fff;border-radius:50%;width:18px;height:18px;font-size:10px;display:flex;align-items:center;justify-content:center;font-weight:700;border:2px solid var(--bg)}

/* HAMBURGER */
.hamburger{display:none;flex-direction:column;justify-content:center;gap:5px;background:none;border:1.5px solid var(--border);border-radius:var(--radius);padding:8px 10px;cursor:pointer;transition:background .15s}
.hamburger:hover{background:var(--surface)}
.hamburger span{display:block;width:18px;height:2px;background:var(--text);border-radius:2px;transition:all .25s}
.hamburger.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.hamburger.open span:nth-child(2){opacity:0;transform:scaleX(0)}
.hamburger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}

/* MOBILE NAV DRAWER */
#mobile-nav{position:fixed;inset:0;z-index:150;pointer-events:none;display:none}
#mobile-nav.open{pointer-events:all}
#mobile-nav-overlay{position:absolute;inset:0;background:rgba(0,0,0,.5);opacity:0;transition:opacity .3s}
#mobile-nav.open #mobile-nav-overlay{opacity:1}
#mobile-nav-drawer{position:absolute;left:0;top:0;bottom:0;width:280px;background:var(--bg);transform:translateX(-100%);transition:transform .3s;display:flex;flex-direction:column;box-shadow:8px 0 40px rgba(0,0,0,.15)}
#mobile-nav.open #mobile-nav-drawer{transform:translateX(0)}
.mobile-nav-header{padding:1.25rem 1.5rem;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center}
.mobile-nav-logo{font-family:var(--font-heading);font-size:22px;font-weight:700;color:var(--text)}
.mobile-nav-close{background:none;border:1px solid var(--border);border-radius:var(--radius);padding:6px 10px;cursor:pointer;font-size:16px;display:flex;align-items:center}
.mobile-nav-links{padding:1rem 0;flex:1;overflow-y:auto}
.mobile-nav-link{display:flex;align-items:center;gap:12px;padding:15px 1.5rem;font-size:15px;color:var(--text);cursor:pointer;transition:background .15s;border:none;background:none;font-family:inherit;width:100%;text-align:left;letter-spacing:.03em}
.mobile-nav-link:hover{background:var(--surface)}
.mobile-nav-link i{font-size:19px;opacity:.45}

#hero{background:var(--text);color:#fff;padding:4rem 1.5rem;text-align:center;position:relative;overflow:hidden}
#hero::before{content:'';position:absolute;inset:0;background:repeating-linear-gradient(45deg,transparent,transparent 40px,rgba(255,255,255,.02) 40px,rgba(255,255,255,.02) 80px)}
#hero h1{font-size:3.2rem;font-weight:400;line-height:1.05;margin-bottom:1rem;font-style:italic}
#hero p{font-size:1rem;opacity:.65;margin-bottom:2.5rem;font-weight:300;letter-spacing:.04em}
.hero-btns{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:6px;padding:12px 24px;border-radius:var(--radius);font-size:13px;font-weight:500;cursor:pointer;transition:all .2s;border:none;font-family:inherit;text-decoration:none;letter-spacing:.04em;text-transform:uppercase}
.btn-primary{background:#fff;color:#0A0A0A}.btn-primary:hover{background:#e8e8e8}
.btn-outline{background:transparent;color:#fff;border:1.5px solid rgba(255,255,255,.4)}.btn-outline:hover{border-color:#fff;background:rgba(255,255,255,.1)}
.btn-dark{background:var(--btn-bg);color:var(--btn-text)}.btn-dark:hover{opacity:.8}
.btn-danger{background:var(--danger);color:#fff}.btn-danger:hover{opacity:.85}
.btn-success{background:var(--success);color:#fff}.btn-success:hover{opacity:.85}
.btn-sm{padding:8px 16px;font-size:12px}.btn-xs{padding:5px 10px;font-size:11px}

.section{padding:2.5rem 1rem;max-width:1200px;margin:0 auto}
.section-title{font-size:1.9rem;font-weight:400;margin-bottom:.4rem}
.section-sub{color:var(--muted);font-size:13px;margin-bottom:2rem;letter-spacing:.04em;text-transform:uppercase}

.product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1.5rem}
.product-card{background:var(--bg);border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;cursor:pointer;transition:transform .2s,box-shadow .2s;position:relative}
.product-card:hover{transform:translateY(-3px);box-shadow:0 12px 32px rgba(0,0,0,.12)}
.product-img{width:100%;aspect-ratio:1;background:var(--surface);display:flex;align-items:center;justify-content:center;font-size:4rem;overflow:hidden}
.product-img img{width:100%;height:100%;object-fit:cover}
.product-badge{position:absolute;top:12px;left:12px;background:var(--text);color:#fff;font-size:10px;padding:3px 8px;border-radius:2px;font-weight:500;letter-spacing:.06em;text-transform:uppercase}
.product-badge.sale{background:var(--danger)}
.product-info{padding:1rem}
.product-brand{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;margin-bottom:4px}
.product-name{font-family:var(--font-heading);font-size:17px;font-weight:400;margin-bottom:6px;line-height:1.3}
.product-price{display:flex;align-items:baseline;gap:8px;margin-bottom:10px}
.price{font-size:16px;font-weight:500}
.price-original{font-size:13px;color:var(--muted);text-decoration:line-through}
.product-stars{font-size:12px;margin-bottom:10px;opacity:.6}
.quick-add{width:100%;background:var(--btn-bg);color:var(--btn-text);border:none;padding:10px;font-size:11px;font-weight:500;cursor:pointer;font-family:inherit;transition:opacity .2s;text-transform:uppercase;letter-spacing:.06em}
.quick-add:hover{opacity:.75}

/* CART DRAWER */
#cart-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:200;opacity:0;pointer-events:none;transition:opacity .3s}
#cart-overlay.open{opacity:1;pointer-events:all}
#cart-drawer{position:fixed;right:0;top:0;bottom:0;width:500px;max-width:100vw;background:var(--bg);z-index:201;transform:translateX(100%);transition:transform .3s;display:flex;flex-direction:column;box-shadow:-8px 0 40px rgba(0,0,0,.15)}
#cart-drawer.open{transform:translateX(0)}
.cart-header{padding:1.25rem 1.5rem;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;flex-shrink:0}
.cart-header h2{font-family:var(--font-heading);font-size:20px;font-weight:400;display:flex;align-items:center;gap:8px}
.cart-items{flex:1;overflow-y:auto;padding:1rem 1.5rem;-webkit-overflow-scrolling:touch}
.cart-item{display:flex;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--border)}
.cart-item-img{width:72px;height:72px;background:var(--surface);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;font-size:2rem;flex-shrink:0;overflow:hidden}
.cart-item-img img{width:100%;height:100%;object-fit:cover}
.cart-item-info{flex:1}
.cart-item-name{font-size:14px;font-weight:500;margin-bottom:4px}
.cart-item-price{font-size:13px;color:var(--muted)}
.cart-qty{display:flex;align-items:center;gap:8px;margin-top:8px}
.qty-btn{width:34px;height:34px;border:1px solid var(--border);background:var(--bg);border-radius:var(--radius);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:16px}
.qty-btn:hover{background:var(--surface)}
.qty-num{font-size:14px;font-weight:500;min-width:20px;text-align:center}
.cart-footer{padding:1.25rem 1.5rem;border-top:1px solid var(--border);flex-shrink:0}
.cart-total-row{display:flex;justify-content:space-between;font-size:18px;font-weight:500;margin-bottom:1rem;padding-bottom:.75rem;border-bottom:1px solid var(--border)}
.cart-empty{text-align:center;padding:3rem 1rem;color:var(--muted)}

/* SHIPPING FORM */
.shipping-section{background:var(--surface);border-radius:var(--radius-lg);padding:1.25rem;margin-bottom:1rem;border:1px solid var(--border)}
.shipping-section h4{font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;margin-bottom:1rem;color:var(--text);display:flex;align-items:center;gap:6px}
.shipping-form{display:flex;flex-direction:column;gap:8px}
.shipping-form input,.shipping-form select{padding:13px 12px;border:1.5px solid var(--border);border-radius:var(--radius);font-size:16px;font-family:inherit;background:var(--bg);color:var(--text);outline:none;transition:border-color .2s;width:100%;-webkit-appearance:none}
.shipping-form input:focus,.shipping-form select:focus{border-color:var(--text)}
.shipping-form input.error,.shipping-form select.error{border-color:var(--danger);background:#fff8f8}
.ship-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.ship-row-3{display:grid;grid-template-columns:2fr 1fr 1fr;gap:8px}

/* PAYMENT */
.payment-section{background:var(--surface);border-radius:var(--radius-lg);padding:1.25rem;margin-bottom:1rem;border:1px solid var(--border)}
.payment-section h4{font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;margin-bottom:1rem;color:var(--text);display:flex;align-items:center;gap:6px}
.card-form{display:flex;flex-direction:column;gap:8px}
.card-form input{padding:13px 12px;border:1.5px solid var(--border);border-radius:var(--radius);font-size:16px;font-family:inherit;background:var(--bg);color:var(--text);outline:none;transition:border-color .2s;width:100%;-webkit-appearance:none}
.card-form input:focus{border-color:var(--text)}
.card-form input.error{border-color:var(--danger);background:#fff8f8}
.card-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.card-brand-row{display:flex;gap:8px;align-items:center;margin-bottom:8px;flex-wrap:wrap}
.card-brand{font-size:11px;color:var(--muted);display:flex;align-items:center;gap:4px;background:var(--bg);border:1px solid var(--border);padding:5px 9px;border-radius:4px;font-weight:500}
.card-brand i{font-size:15px}
.secure-badge{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--muted);margin-top:.5rem}
.payment-error{background:#fff0f0;border:1px solid #ffcdd2;border-radius:var(--radius);padding:10px 12px;font-size:12px;color:var(--danger);margin-bottom:8px;display:none;align-items:center;gap:6px;line-height:1.4}
.payment-required-notice{background:#FEF3E2;border:1px solid #FAC775;border-radius:var(--radius);padding:10px 12px;font-size:12px;color:#9A6500;margin-bottom:8px;display:flex;align-items:center;gap:6px;line-height:1.4}

/* PRODUCT MODAL */
#product-overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:300;opacity:0;pointer-events:none;transition:opacity .3s;display:flex;align-items:center;justify-content:center;padding:1rem}
#product-overlay.open{opacity:1;pointer-events:all}
#product-modal{background:var(--bg);border-radius:var(--radius-xl);max-width:800px;width:100%;max-height:90vh;overflow-y:auto;transform:scale(.95);transition:transform .3s}
#product-overlay.open #product-modal{transform:scale(1)}
.modal-grid{display:grid;grid-template-columns:1fr 1fr}
.modal-img{background:var(--surface);aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:6rem;border-radius:var(--radius-xl) 0 0 var(--radius-xl);overflow:hidden}
.modal-img img{width:100%;height:100%;object-fit:cover}
.modal-info{padding:2rem}
.modal-brand{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;margin-bottom:6px}
.modal-name{font-family:var(--font-heading);font-size:26px;font-weight:400;line-height:1.2;margin-bottom:12px}
.modal-price{font-size:24px;font-weight:500;margin-bottom:1rem}
.modal-desc{font-size:14px;color:var(--muted);line-height:1.6;margin-bottom:1.5rem}
.modal-close{position:absolute;top:1rem;right:1rem;background:var(--surface);border:none;width:36px;height:36px;border-radius:50%;cursor:pointer;font-size:18px;display:flex;align-items:center;justify-content:center}
.variant-label{font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-bottom:8px}
.variants{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:1.25rem}
.variant-btn{padding:8px 14px;border:1.5px solid var(--border);border-radius:var(--radius);font-size:14px;cursor:pointer;background:var(--bg);font-family:inherit;transition:all .2s;min-height:44px}
.variant-btn.active{border-color:var(--text);background:var(--surface)}
.variant-btn:hover{border-color:var(--text)}

/* SEARCH */
#search-overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:400;opacity:0;pointer-events:none;transition:opacity .2s;display:flex;align-items:flex-start;justify-content:center;padding:1.5rem 1rem 0}
#search-overlay.open{opacity:1;pointer-events:all}
.search-box{background:var(--bg);border-radius:var(--radius-lg);width:100%;max-width:600px;overflow:hidden;box-shadow:0 24px 64px rgba(0,0,0,.25)}
.search-input-wrap{display:flex;align-items:center;padding:.75rem 1.25rem;border-bottom:1px solid var(--border);gap:10px;background:var(--surface)}
.search-icon-circle{width:36px;height:36px;background:var(--btn-bg);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.search-icon-circle i{font-size:18px;color:#fff}
#search-input{flex:1;border:none;background:transparent;font-size:16px;color:var(--text);font-family:inherit;outline:none;padding:4px 0}
#search-input::placeholder{color:var(--muted)}
.search-close-btn{background:none;border:1px solid var(--border);border-radius:var(--radius);padding:6px 12px;cursor:pointer;font-size:12px;color:var(--muted);font-family:inherit;display:flex;align-items:center;gap:4px;min-height:36px}
.search-close-btn:hover{background:var(--border)}
.search-results{padding:1rem;max-height:60vh;overflow-y:auto;-webkit-overflow-scrolling:touch}
.search-result-item{display:flex;gap:12px;padding:.85rem;border-radius:var(--radius);cursor:pointer;align-items:center;transition:background .15s}
.search-result-item:hover{background:var(--surface)}
.search-result-thumb{width:48px;height:48px;display:flex;align-items:center;justify-content:center;background:var(--surface);border-radius:var(--radius);flex-shrink:0;overflow:hidden;font-size:1.8rem}
.search-result-thumb img{width:100%;height:100%;object-fit:cover}
.search-result-name{font-size:14px;font-weight:500}
.search-result-price{font-size:13px;color:var(--muted)}

/* ADMIN TRIGGER */
#admin-trigger{position:fixed;bottom:24px;right:24px;z-index:500;background:var(--btn-bg);color:var(--btn-text);border:none;width:48px;height:48px;border-radius:50%;cursor:pointer;font-size:20px;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(0,0,0,.25);transition:all .2s;opacity:.5}
#admin-trigger:hover{opacity:1;transform:scale(1.08)}
#admin-login{position:fixed;bottom:84px;right:16px;background:var(--bg);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.25rem;z-index:500;width:min(280px,calc(100vw - 32px));display:none;box-shadow:0 8px 32px rgba(0,0,0,.15)}
#admin-login.open{display:block}
#admin-login h3{font-family:var(--font-heading);font-size:16px;margin-bottom:1rem;display:flex;align-items:center;gap:8px}
.field{margin-bottom:.75rem}
.field label{display:block;font-size:11px;color:var(--muted);margin-bottom:4px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;display:flex;align-items:center;gap:5px}
.field label i{font-size:14px;opacity:.6}
.field input,.field select,.field textarea{width:100%;padding:10px 12px;border:1px solid var(--border);border-radius:var(--radius);font-size:14px;font-family:inherit;background:var(--bg);color:var(--text);outline:none}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--text)}
.field textarea{resize:vertical;min-height:70px}

/* ADMIN PANEL */
#admin-panel{position:fixed;inset:0;z-index:600;background:var(--bg);overflow:hidden;display:none;flex-direction:column}
#admin-panel.open{display:flex}
#admin-topbar{background:var(--text);color:#fff;display:flex;align-items:center;gap:.75rem;padding:0 1rem;height:56px;flex-shrink:0}
#admin-topbar h1{font-family:var(--font-heading);font-size:18px;font-weight:400;flex:1;font-style:italic;display:flex;align-items:center;gap:8px}
.admin-body{display:flex;flex:1;overflow:hidden}
#admin-sidebar{width:220px;background:#111;border-right:1px solid #333;padding:.75rem 0;flex-shrink:0;overflow-y:auto}
.sidebar-section-label{font-size:9px;text-transform:uppercase;letter-spacing:.12em;color:#555;padding:12px 16px 4px;font-weight:600;display:flex;align-items:center;gap:6px}
.sidebar-section-label i{font-size:13px}
.admin-nav-item{display:flex;align-items:center;gap:10px;padding:11px 16px;font-size:13px;color:#aaa;cursor:pointer;transition:all .15s;border-left:3px solid transparent}
.admin-nav-item:hover{color:#fff;background:rgba(255,255,255,.06)}
.admin-nav-item.active{color:#fff;background:rgba(255,255,255,.1);border-left-color:#fff}
.admin-nav-item i{font-size:18px;flex-shrink:0}
.admin-nav-item span{font-size:13px}
.admin-content{flex:1;overflow-y:auto;padding:1.5rem;-webkit-overflow-scrolling:touch}
.admin-section{display:none}
.admin-section.active{display:block}
.admin-page-title{font-family:var(--font-heading);font-size:24px;font-weight:400;font-style:italic;margin-bottom:1.5rem;display:flex;align-items:center;gap:10px}
.admin-page-title i{font-size:22px;opacity:.6}

.stats-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:1rem;margin-bottom:2rem}
.stat-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.25rem;position:relative;overflow:hidden}
.stat-icon{font-size:24px;margin-bottom:.5rem;opacity:.5}
.stat-label{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:.4rem;font-weight:600}
.stat-value{font-size:2rem;font-family:var(--font-heading);font-weight:400;line-height:1}
.stat-change{font-size:11px;margin-top:6px}
.stat-change.up{color:var(--success)}.stat-change.down{color:var(--danger)}

.data-table{width:100%;border-collapse:collapse;font-size:14px}
.data-table th{text-align:left;padding:10px 12px;border-bottom:2px solid var(--border);font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);font-weight:600}
.data-table th i{font-size:13px;vertical-align:middle;margin-right:4px;opacity:.6}
.data-table td{padding:12px;border-bottom:1px solid var(--border);vertical-align:middle}
.data-table tr:last-child td{border-bottom:none}
.data-table tr:hover td{background:var(--surface)}
.table-wrap{background:var(--bg);border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;margin-bottom:1.5rem}
.badge{display:inline-block;padding:3px 8px;border-radius:2px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.06em}
.badge-green{background:#E5F5E5;color:#2D7A2D}
.badge-red{background:#FDECEC;color:#B92B2B}
.badge-amber{background:#FEF3E2;color:#9A6500}
.badge-gray{background:#F0F0F0;color:#6B6B6B}
.badge-blue{background:#E8F0FE;color:#1A56DB}

.ship-info-box{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:8px 10px;font-size:12px;line-height:1.5;color:var(--text);max-width:200px}
.ship-info-box strong{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:2px}

.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.col-span-2{grid-column:span 2}
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:700;display:flex;align-items:center;justify-content:center;padding:1rem}
.modal-box{background:var(--bg);border-radius:var(--radius-xl);padding:1.5rem;width:100%;max-width:680px;max-height:90vh;overflow-y:auto}
.modal-box h2{font-family:var(--font-heading);font-size:22px;font-weight:400;margin-bottom:1.5rem;display:flex;align-items:center;gap:8px}
.section-divider{border:none;border-top:1px solid var(--border);margin:1.5rem 0}
.img-upload-area{border:2px dashed var(--border);border-radius:var(--radius-lg);padding:2rem;text-align:center;cursor:pointer;transition:all .2s;position:relative;overflow:hidden}
.img-upload-area:hover{border-color:var(--text);background:var(--surface)}
.img-upload-area input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%}
.img-preview{width:100%;height:160px;object-fit:cover;border-radius:var(--radius);margin-top:.75rem;display:none}
.emoji-picker{display:grid;grid-template-columns:repeat(8,1fr);gap:6px;padding:.75rem;background:var(--surface);border-radius:var(--radius);border:1px solid var(--border)}
.emoji-opt{font-size:1.4rem;cursor:pointer;padding:6px;border-radius:6px;text-align:center;transition:background .1s;min-height:40px;display:flex;align-items:center;justify-content:center}
.emoji-opt:hover{background:var(--border)}
.emoji-opt.selected{outline:2px solid var(--text)}
.selected-emoji{font-size:2.5rem;text-align:center;padding:.5rem;background:var(--surface);border-radius:var(--radius);margin-bottom:.75rem}

.color-swatch{width:28px;height:28px;border-radius:50%;cursor:pointer;border:2px solid transparent;transition:border-color .2s;flex-shrink:0}
.color-swatch.selected{border-color:var(--text)}
.font-option{padding:8px 14px;border:1.5px solid var(--border);border-radius:var(--radius);cursor:pointer;font-size:13px;transition:all .2s;background:var(--bg)}
.font-option:hover{border-color:var(--text)}
.font-option.selected{border-color:var(--text);background:var(--surface);font-weight:600}

.earnings-card{background:var(--text);color:#fff;border-radius:var(--radius-xl);padding:2rem;margin-bottom:1.5rem}
.earnings-total{font-family:var(--font-heading);font-size:3.5rem;font-weight:400;margin-bottom:.25rem}
.earnings-label{font-size:12px;opacity:.6;text-transform:uppercase;letter-spacing:.08em}
.earnings-breakdown{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:1rem;margin-top:1.5rem}
.earnings-item{background:rgba(255,255,255,.08);border-radius:var(--radius-lg);padding:1rem}
.earnings-item-label{font-size:11px;opacity:.6;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.25rem;display:flex;align-items:center;gap:4px}
.earnings-item-label i{font-size:13px}
.earnings-item-val{font-size:1.4rem;font-family:var(--font-heading);font-weight:400}
.payout-info{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.25rem;margin-bottom:1.5rem}
.payout-info h4{font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.75rem;display:flex;align-items:center;gap:6px}

.trust-bar{background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:.875rem 1rem}
.trust-inner{max-width:1200px;margin:0 auto;display:flex;justify-content:space-around;flex-wrap:wrap;gap:.75rem}
.trust-item{display:flex;align-items:center;gap:.5rem;font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
.trust-item i{font-size:18px;color:var(--text)}

.collection-banner{background:var(--text);color:#fff;border-radius:var(--radius-xl);padding:2rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1.5rem;margin-bottom:2rem}
.collection-banner-text h2{font-family:var(--font-heading);font-size:1.8rem;font-weight:400;margin-bottom:.5rem;font-style:italic}
.collection-banner-text p{opacity:.65;font-size:13px}
.collection-banner-emoji{font-size:3.5rem;opacity:.8}

footer{background:var(--text);color:#fff;padding:3rem 1.5rem;margin-top:4rem}
.footer-grid{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:2rem}
.footer-brand{font-family:var(--font-heading);font-size:26px;font-weight:400;margin-bottom:.5rem;font-style:italic}
.footer-sub{font-size:13px;opacity:.5;line-height:1.6}
.footer-heading{font-size:10px;text-transform:uppercase;letter-spacing:.1em;opacity:.4;margin-bottom:.75rem;font-weight:600}
.footer-links{list-style:none;display:flex;flex-direction:column;gap:.5rem}
.footer-links li{font-size:13px;opacity:.6;cursor:pointer}
.footer-links li:hover{opacity:1}
.footer-bottom{max-width:1200px;margin:2rem auto 0;padding-top:1.5rem;border-top:1px solid rgba(255,255,255,.1);font-size:12px;opacity:.4;text-align:center}

#toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(60px);background:var(--text);color:#fff;padding:10px 20px;border-radius:var(--radius);font-size:14px;z-index:900;transition:transform .3s;display:flex;align-items:center;gap:8px;max-width:calc(100vw - 48px);text-align:center}
#toast.show{transform:translateX(-50%) translateY(0)}

.empty-store{text-align:center;padding:5rem 2rem;color:var(--muted)}
.empty-store i{font-size:4rem;display:block;margin-bottom:1rem;opacity:.2}
.empty-store h3{font-family:var(--font-heading);font-size:1.5rem;font-weight:400;margin-bottom:.5rem;color:var(--text)}
.empty-store p{font-size:14px;max-width:360px;margin:0 auto}

/* ── MOBILE RESPONSIVE ── */
@media(max-width:768px){
  .nav-links{display:none}
  .hamburger{display:flex}
  #mobile-nav{display:block}
  .icon-btn-label{display:none}
  .icon-btn{padding:8px 10px}

  #hero{padding:3rem 1.25rem}
  #hero h1{font-size:2.4rem}

  .section{padding:1.75rem 1rem}
  .product-grid{grid-template-columns:repeat(2,1fr);gap:.75rem}
  .product-name{font-size:14px}
  .product-info{padding:.75rem}

  /* Full-screen cart on mobile */
  #cart-drawer{width:100vw;max-width:100vw}
  .cart-items{padding:.75rem 1rem}
  .cart-footer{padding:1rem}
  .ship-row,.ship-row-3,.card-row{grid-template-columns:1fr}

  /* Product modal — sheet from bottom */
  #product-overlay{padding:0;align-items:flex-end}
  #product-modal{border-radius:var(--radius-xl) var(--radius-xl) 0 0;max-height:92vh}
  .modal-grid{grid-template-columns:1fr}
  .modal-img{border-radius:var(--radius-xl) var(--radius-xl) 0 0;aspect-ratio:16/9;font-size:4rem}
  .modal-info{padding:1.25rem}
  .modal-name{font-size:20px}
  .modal-price{font-size:20px}

  .collection-banner{padding:1.5rem}
  .collection-banner-text h2{font-size:1.5rem}

  /* Admin sidebar collapses to icons only */
  #admin-sidebar{width:52px}
  .admin-nav-item span,.sidebar-section-label span{display:none}
  .admin-nav-item{justify-content:center;padding:13px}
  .admin-content{padding:1rem}
  .admin-page-title{font-size:19px}
  .stats-grid{grid-template-columns:1fr 1fr}
  .form-grid{grid-template-columns:1fr}
  .col-span-2{grid-column:span 1}

  .footer-grid{grid-template-columns:1fr 1fr}

  #search-overlay{padding-top:1.5rem}
}

@media(max-width:420px){
  .product-grid{grid-template-columns:1fr}
  #hero h1{font-size:2rem}
  .hero-btns{flex-direction:column;align-items:stretch}
  .hero-btns .btn{justify-content:center}
  .trust-inner{justify-content:flex-start;gap:.5rem}
}

::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}
</style>
</head>
<body>

<div id="topbar">Free shipping on orders over $75 · Use code WELCOME10 for 10% off</div>

<nav id="navbar">
  <div style="display:flex;align-items:center;gap:.75rem">
    <button class="hamburger" id="hamburger-btn" onclick="toggleMobileNav()" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
    <div class="nav-logo" onclick="filterCollection('all')">ShopForge</div>
  </div>
  <div class="nav-links">
    <button class="nav-link" onclick="filterCollection('all')">All Products</button>
    <button class="nav-link" onclick="filterCollection('clothing')">Clothing</button>
    <button class="nav-link" onclick="filterCollection('accessories')">Accessories</button>
    <button class="nav-link" onclick="filterCollection('home')">Home</button>
    <button class="nav-link" onclick="filterCollection('sale')">Sale</button>
  </div>
  <div class="nav-actions">
    <button class="icon-btn" onclick="openSearch()" aria-label="Search products">
      <i class="ti ti-search"></i>
      <span class="icon-btn-label">Search</span>
    </button>
    <button class="icon-btn" onclick="openCart()" aria-label="View cart" style="position:relative">
      <i class="ti ti-shopping-bag"></i>
      <span class="icon-btn-label">Cart</span>
      <span class="cart-badge" id="cart-count" style="display:none">0</span>
    </button>
  </div>
</nav>

<!-- MOBILE NAV DRAWER -->
<div id="mobile-nav">
  <div id="mobile-nav-overlay" onclick="closeMobileNav()"></div>
  <div id="mobile-nav-drawer">
    <div class="mobile-nav-header">
      <div class="mobile-nav-logo">ShopForge</div>
      <button class="mobile-nav-close" onclick="closeMobileNav()"><i class="ti ti-x"></i></button>
    </div>
    <div class="mobile-nav-links">
      <button class="mobile-nav-link" onclick="closeMobileNav();filterCollection('all')"><i class="ti ti-layout-grid"></i> All Products</button>
      <button class="mobile-nav-link" onclick="closeMobileNav();filterCollection('clothing')"><i class="ti ti-shirt"></i> Clothing</button>
      <button class="mobile-nav-link" onclick="closeMobileNav();filterCollection('accessories')"><i class="ti ti-backpack"></i> Accessories</button>
      <button class="mobile-nav-link" onclick="closeMobileNav();filterCollection('home')"><i class="ti ti-home"></i> Home</button>
      <button class="mobile-nav-link" onclick="closeMobileNav();filterCollection('sale')"><i class="ti ti-tag"></i> Sale</button>
    </div>
  </div>
</div>

<div id="storefront">
  <div id="hero">
    <h1>Curated for<br>everyday living</h1>
    <p>Premium goods, thoughtfully selected for modern life</p>
    <div class="hero-btns">
      <button class="btn btn-primary" onclick="scrollToProducts()">Shop Now</button>
      <button class="btn btn-outline" onclick="filterCollection('sale')">View Sale</button>
    </div>
  </div>

  <div class="trust-bar">
    <div class="trust-inner">
      <div class="trust-item"><i class="ti ti-truck"></i> Free shipping over $75</div>
      <div class="trust-item"><i class="ti ti-refresh"></i> 30-day returns</div>
      <div class="trust-item"><i class="ti ti-shield-check"></i> Secure checkout</div>
      <div class="trust-item"><i class="ti ti-star"></i> 4.9/5 rating</div>
    </div>
  </div>

  <div class="section" id="products-section">
    <div class="collection-banner">
      <div class="collection-banner-text">
        <h2>New Arrivals</h2>
        <p>Fresh picks just landed — explore the latest additions.</p>
      </div>
      <div class="collection-banner-emoji">🌿</div>
    </div>
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;flex-wrap:wrap;gap:.75rem">
      <div>
        <h2 class="section-title" id="section-heading">All Products</h2>
        <p class="section-sub" id="section-sub">Explore our full range</p>
      </div>
      <select id="sort-select" style="padding:8px 12px;border:1px solid var(--border);border-radius:var(--radius);font-size:12px;background:var(--bg);font-family:inherit;color:var(--text)" onchange="sortProducts()">
        <option value="featured">Featured</option>
        <option value="price-asc">Price: Low to High</option>
        <option value="price-desc">Price: High to Low</option>
        <option value="name">Alphabetically</option>
      </select>
    </div>
    <div class="product-grid" id="product-grid"></div>
    <p id="no-products" style="display:none;text-align:center;color:var(--muted);padding:3rem 0">No products found in this collection.</p>
  </div>

  <footer>
    <div class="footer-grid">
      <div>
        <div class="footer-brand">ShopForge</div>
        <p class="footer-sub">Premium goods for everyday living, curated with care.</p>
      </div>
      <div>
        <div class="footer-heading">Shop</div>
        <ul class="footer-links">
          <li onclick="filterCollection('all')">All Products</li>
          <li onclick="filterCollection('clothing')">Clothing</li>
          <li onclick="filterCollection('accessories')">Accessories</li>
          <li onclick="filterCollection('home')">Home</li>
          <li onclick="filterCollection('sale')">Sale</li>
        </ul>
      </div>
      <div>
        <div class="footer-heading">Help</div>
        <ul class="footer-links"><li>Shipping Info</li><li>Returns</li><li>Size Guide</li><li>FAQ</li><li>Contact</li></ul>
      </div>
      <div>
        <div class="footer-heading">Company</div>
        <ul class="footer-links"><li>About Us</li><li>Sustainability</li><li>Careers</li><li>Press</li></ul>
      </div>
    </div>
    <div class="footer-bottom">© 2026 ShopForge. All rights reserved.</div>
  </footer>
</div>

<!-- CART DRAWER -->
<div id="cart-overlay" onclick="closeCart()"></div>
<div id="cart-drawer">
  <div class="cart-header">
    <h2><i class="ti ti-shopping-bag" style="font-size:20px"></i> Your Cart <span id="cart-item-count" style="font-size:14px;color:var(--muted);font-family:var(--font-body);font-weight:400"></span></h2>
    <button class="icon-btn" onclick="closeCart()" style="border:none;padding:8px"><i class="ti ti-x"></i></button>
  </div>
  <div class="cart-items" id="cart-items-list"></div>
  <div class="cart-footer" id="cart-footer" style="display:none">
    <div class="cart-total-row">
      <span style="display:flex;align-items:center;gap:6px"><i class="ti ti-receipt" style="font-size:16px;opacity:.5"></i> Total</span>
      <span id="cart-total" style="font-size:20px">$0.00</span>
    </div>

    <div class="shipping-section">
      <h4><i class="ti ti-map-pin"></i> Shipping Address — Required</h4>
      <div class="shipping-form">
        <div class="ship-row">
          <input type="text" placeholder="First Name *" id="sh-first" autocomplete="given-name">
          <input type="text" placeholder="Last Name *" id="sh-last" autocomplete="family-name">
        </div>
        <input type="text" placeholder="Street Address *" id="sh-street" autocomplete="street-address">
        <input type="text" placeholder="Apt, Suite, Unit (optional)" id="sh-apt" autocomplete="address-line2">
        <div class="ship-row-3">
          <input type="text" placeholder="City *" id="sh-city" autocomplete="address-level2">
          <input type="text" placeholder="State *" id="sh-state" autocomplete="address-level1">
          <input type="text" placeholder="ZIP *" id="sh-zip" autocomplete="postal-code" inputmode="numeric">
        </div>
        <input type="text" placeholder="Country *" id="sh-country" autocomplete="country-name" value="United States">
        <input type="tel" placeholder="Phone Number *" id="sh-phone" autocomplete="tel" inputmode="tel">
        <input type="email" placeholder="Email Address *" id="sh-email" autocomplete="email">
      </div>
    </div>

    <div class="payment-required-notice">
      <i class="ti ti-alert-circle" style="font-size:16px;flex-shrink:0"></i>
      <span>Payment is required to confirm your order. Enter your card details below to complete checkout.</span>
    </div>
    <div class="payment-section">
      <h4><i class="ti ti-credit-card"></i> Pay with Card — Required</h4>
      <div class="card-brand-row">
        <div class="card-brand"><i class="ti ti-brand-visa"></i> Visa</div>
        <div class="card-brand"><i class="ti ti-brand-mastercard"></i> Mastercard</div>
        <div class="card-brand"><i class="ti ti-credit-card"></i> Amex</div>
        <div class="card-brand"><i class="ti ti-credit-card"></i> Discover</div>
      </div>
      <div id="payment-error" class="payment-error"><i class="ti ti-alert-triangle" style="font-size:16px;flex-shrink:0"></i> <span id="payment-error-msg">Please fill in all required fields.</span></div>
      <div class="card-form">
        <input type="text" placeholder="Cardholder Name" id="cc-name" maxlength="60" autocomplete="cc-name">
        <input type="text" placeholder="Card Number (16 digits)" id="cc-num" maxlength="19" oninput="formatCard(this)" autocomplete="cc-number" inputmode="numeric">
        <div class="card-row">
          <input type="text" placeholder="MM / YY" id="cc-exp" maxlength="7" oninput="formatExp(this)" autocomplete="cc-exp" inputmode="numeric">
          <input type="text" placeholder="CVV" id="cc-cvv" maxlength="4" autocomplete="cc-csc" inputmode="numeric">
        </div>
      </div>
      <div class="secure-badge"><i class="ti ti-lock" style="font-size:14px"></i> 256-bit SSL encrypted · PCI DSS compliant · Payment verified before fulfillment</div>
    </div>

    <button class="btn btn-dark" style="width:100%;justify-content:center;padding:16px;font-size:14px" onclick="checkout()">
      <i class="ti ti-lock"></i> Pay & Confirm Order — <span id="cart-total-btn">$0.00</span>
    </button>
    <p style="text-align:center;font-size:11px;color:var(--muted);margin-top:.75rem;display:flex;align-items:center;justify-content:center;gap:4px">
      <i class="ti ti-info-circle" style="font-size:13px"></i> Orders are only accepted after successful payment verification
    </p>
  </div>
</div>

<!-- PRODUCT MODAL -->
<div id="product-overlay" onclick="closeProductModal(event)">
  <div id="product-modal">
    <button class="modal-close" onclick="closeProductModal()" style="position:sticky;top:1rem;left:calc(100% - 2.5rem);z-index:10"><i class="ti ti-x"></i></button>
    <div class="modal-grid">
      <div class="modal-img" id="modal-img">📦</div>
      <div class="modal-info">
        <div class="modal-brand" id="modal-brand"></div>
        <div class="modal-name" id="modal-name"></div>
        <div class="modal-price" id="modal-price"></div>
        <div class="modal-desc" id="modal-desc"></div>
        <div id="modal-variants-section"></div>
        <button class="btn btn-dark" style="width:100%;justify-content:center;padding:14px;margin-bottom:.75rem" onclick="addFromModal()">
          <i class="ti ti-shopping-bag"></i> Add to Cart
        </button>
        <div style="display:flex;gap:.5rem">
          <div style="font-size:11px;color:var(--muted);display:flex;align-items:center;gap:4px"><i class="ti ti-truck" style="font-size:13px"></i> Free over $75</div>
          <div style="font-size:11px;color:var(--muted);display:flex;align-items:center;gap:4px;margin-left:auto"><i class="ti ti-refresh" style="font-size:13px"></i> 30-day returns</div>
        </div>
      </div>
    </div>
    <div style="padding:1.5rem">
      <h3 style="font-family:var(--font-heading);font-size:16px;font-weight:400;margin-bottom:.75rem">Product Details</h3>
      <div id="modal-details" style="font-size:14px;color:var(--muted);line-height:1.7"></div>
    </div>
  </div>
</div>

<!-- SEARCH -->
<div id="search-overlay" onclick="closeSearch(event)">
  <div class="search-box">
    <div class="search-input-wrap">
      <div class="search-icon-circle"><i class="ti ti-search"></i></div>
      <input type="text" id="search-input" placeholder="Search products, brands…" oninput="doSearch()">
      <button class="search-close-btn" onclick="closeSearch()"><i class="ti ti-x" style="font-size:13px"></i> Close</button>
    </div>
    <div class="search-results" id="search-results">
      <p style="font-size:12px;color:var(--muted);padding:.5rem .25rem;display:flex;align-items:center;gap:6px"><i class="ti ti-keyboard" style="font-size:15px"></i> Start typing to search products…</p>
    </div>
  </div>
</div>

<!-- ADMIN TRIGGER -->
<button id="admin-trigger" onclick="toggleAdminLogin()" title="Admin Login"><i class="ti ti-settings-2"></i></button>
<div id="admin-login">
  <h3><i class="ti ti-shield-lock"></i> Admin Access</h3>
  <div class="field">
    <label><i class="ti ti-user"></i> Username</label>
    <input type="text" id="admin-user" placeholder="Username">
  </div>
  <div class="field">
    <label><i class="ti ti-key"></i> Password</label>
    <input type="password" id="admin-pass" placeholder="Password" onkeydown="if(event.key==='Enter')adminLogin()">
  </div>
  <div style="display:flex;gap:8px;margin-top:.75rem">
    <button class="btn btn-dark btn-sm" style="flex:1;justify-content:center" onclick="adminLogin()"><i class="ti ti-login"></i> Log In</button>
    <button class="btn btn-sm" style="border:1px solid var(--border)" onclick="toggleAdminLogin()"><i class="ti ti-x"></i></button>
  </div>
</div>

<!-- ADMIN PANEL -->
<div id="admin-panel">
  <div id="admin-topbar">
    <h1><i class="ti ti-building-store"></i> ShopForge Admin</h1>
    <button class="btn btn-sm" style="background:rgba(255,255,255,.15);color:#fff;border:none;gap:6px" onclick="viewStore()"><i class="ti ti-eye"></i> View Store</button>
    <button class="btn btn-sm" style="background:rgba(255,255,255,.1);color:#fff;border:none;gap:6px" onclick="adminLogout()"><i class="ti ti-logout"></i> Logout</button>
  </div>
  <div class="admin-body">
    <div id="admin-sidebar">
      <div class="sidebar-section-label"><i class="ti ti-chart-bar"></i> <span>Overview</span></div>
      <div class="admin-nav-item active" onclick="adminNav('dashboard')" id="nav-dashboard"><i class="ti ti-layout-dashboard"></i><span>Dashboard</span></div>
      <div class="admin-nav-item" onclick="adminNav('earnings')" id="nav-earnings"><i class="ti ti-coins"></i><span>My Earnings</span></div>
      <div class="sidebar-section-label" style="margin-top:8px"><i class="ti ti-building-store"></i> <span>Store</span></div>
      <div class="admin-nav-item" onclick="adminNav('products')" id="nav-products"><i class="ti ti-package"></i><span>Products</span></div>
      <div class="admin-nav-item" onclick="adminNav('orders')" id="nav-orders"><i class="ti ti-clipboard-list"></i><span>Orders</span></div>
      <div class="admin-nav-item" onclick="adminNav('customers')" id="nav-customers"><i class="ti ti-users"></i><span>Customers</span></div>
      <div class="admin-nav-item" onclick="adminNav('discounts')" id="nav-discounts"><i class="ti ti-tag"></i><span>Discounts</span></div>
      <div class="sidebar-section-label" style="margin-top:8px"><i class="ti ti-tool"></i> <span>Settings</span></div>
      <div class="admin-nav-item" onclick="adminNav('store')" id="nav-store"><i class="ti ti-adjustments-horizontal"></i><span>Store Settings</span></div>
      <div class="admin-nav-item" onclick="adminNav('theme')" id="nav-theme"><i class="ti ti-palette"></i><span>Theme &amp; Fonts</span></div>
    </div>

    <div class="admin-content">

      <!-- DASHBOARD -->
      <div class="admin-section active" id="section-dashboard">
        <div class="admin-page-title"><i class="ti ti-layout-dashboard"></i> Dashboard</div>
        <div class="stats-grid" id="dashboard-stats"></div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem">
          <div>
            <h3 style="font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-bottom:1rem;display:flex;align-items:center;gap:6px"><i class="ti ti-clock" style="font-size:16px;opacity:.5"></i> Recent Orders</h3>
            <div class="table-wrap">
              <table class="data-table">
                <thead><tr><th><i class="ti ti-hash"></i>Order</th><th><i class="ti ti-user"></i>Customer</th><th><i class="ti ti-circle-check"></i>Status</th><th><i class="ti ti-cash"></i>Total</th></tr></thead>
                <tbody id="recent-orders-table"></tbody>
              </table>
            </div>
          </div>
          <div>
            <h3 style="font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-bottom:1rem;display:flex;align-items:center;gap:6px"><i class="ti ti-trending-up" style="font-size:16px;opacity:.5"></i> Top Products</h3>
            <div class="table-wrap">
              <table class="data-table">
                <thead><tr><th><i class="ti ti-package"></i>Product</th><th><i class="ti ti-chart-bar"></i>Sales</th><th><i class="ti ti-cash"></i>Revenue</th></tr></thead>
                <tbody id="top-products-table"></tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- EARNINGS -->
      <div class="admin-section" id="section-earnings">
        <div class="admin-page-title"><i class="ti ti-coins"></i> My Earnings</div>
        <div class="earnings-card">
          <div class="earnings-label">Total Revenue Collected</div>
          <div class="earnings-total" id="earnings-total">$0.00</div>
          <div class="earnings-breakdown" id="earnings-breakdown"></div>
        </div>
        <div class="payout-info">
          <h4><i class="ti ti-bank"></i> Payout Destination</h4>
          <div class="field"><label><i class="ti ti-building-bank"></i> Bank Account / Routing Info</label><input type="text" id="payout-bank" placeholder="e.g. Chase ****4821"></div>
          <div class="field"><label><i class="ti ti-mail"></i> Payout Email (PayPal / Venmo)</label><input type="text" id="payout-email" placeholder="yourname@email.com"></div>
          <div class="field"><label><i class="ti ti-currency-dollar"></i> Cash App Tag</label><input type="text" id="payout-cashapp" placeholder="$YourTag"></div>
          <div class="field"><label><i class="ti ti-notes"></i> Notes</label><textarea id="payout-notes" placeholder="Any notes about your payout preferences…" style="min-height:60px"></textarea></div>
          <button class="btn btn-dark btn-sm" onclick="savePayoutInfo()"><i class="ti ti-device-floppy"></i> Save Payout Info</button>
        </div>
        <h3 style="font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-bottom:1rem;display:flex;align-items:center;gap:6px"><i class="ti ti-list" style="font-size:16px;opacity:.5"></i> Transaction History</h3>
        <div class="table-wrap">
          <table class="data-table">
            <thead><tr><th><i class="ti ti-hash"></i>Order #</th><th><i class="ti ti-calendar"></i>Date</th><th><i class="ti ti-user"></i>Customer</th><th><i class="ti ti-cash"></i>Amount</th><th><i class="ti ti-circle-check"></i>Status</th></tr></thead>
            <tbody id="earnings-table"></tbody>
          </table>
        </div>
      </div>

      <!-- PRODUCTS -->
      <div class="admin-section" id="section-products">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;gap:.75rem">
          <div class="admin-page-title" style="margin-bottom:0"><i class="ti ti-package"></i> Products</div>
          <button class="btn btn-dark btn-sm" onclick="openProductForm()"><i class="ti ti-plus"></i> Add Product</button>
        </div>
        <div class="table-wrap" style="overflow-x:auto">
          <table class="data-table">
            <thead><tr><th><i class="ti ti-package"></i>Product</th><th><i class="ti ti-folder"></i>Collection</th><th><i class="ti ti-cash"></i>Price</th><th><i class="ti ti-box"></i>Stock</th><th><i class="ti ti-circle-check"></i>Status</th><th><i class="ti ti-tool"></i>Actions</th></tr></thead>
            <tbody id="products-admin-table"></tbody>
          </table>
        </div>
      </div>

      <!-- ORDERS -->
      <div class="admin-section" id="section-orders">
        <div class="admin-page-title"><i class="ti ti-clipboard-list"></i> Orders</div>
        <div class="table-wrap" style="overflow-x:auto">
          <table class="data-table">
            <thead><tr>
              <th><i class="ti ti-hash"></i>Order #</th>
              <th><i class="ti ti-calendar"></i>Date</th>
              <th><i class="ti ti-user"></i>Customer</th>
              <th><i class="ti ti-map-pin"></i>Ship To</th>
              <th><i class="ti ti-package"></i>Items</th>
              <th><i class="ti ti-cash"></i>Total</th>
              <th><i class="ti ti-credit-card"></i>Paid</th>
              <th><i class="ti ti-circle-check"></i>Status</th>
              <th><i class="ti ti-edit"></i>Update</th>
            </tr></thead>
            <tbody id="orders-table"></tbody>
          </table>
        </div>
      </div>

      <!-- CUSTOMERS -->
      <div class="admin-section" id="section-customers">
        <div class="admin-page-title"><i class="ti ti-users"></i> Customers</div>
        <div class="table-wrap" style="overflow-x:auto">
          <table class="data-table">
            <thead><tr><th><i class="ti ti-user"></i>Name</th><th><i class="ti ti-mail"></i>Email</th><th><i class="ti ti-clipboard-list"></i>Orders</th><th><i class="ti ti-cash"></i>Total Spent</th><th><i class="ti ti-calendar"></i>Joined</th></tr></thead>
            <tbody id="customers-table"></tbody>
          </table>
        </div>
      </div>

      <!-- DISCOUNTS -->
      <div class="admin-section" id="section-discounts">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;gap:.75rem">
          <div class="admin-page-title" style="margin-bottom:0"><i class="ti ti-tag"></i> Discount Codes</div>
          <button class="btn btn-dark btn-sm" onclick="openDiscountForm()"><i class="ti ti-plus"></i> Add Code</button>
        </div>
        <div class="table-wrap" style="overflow-x:auto">
          <table class="data-table">
            <thead><tr><th><i class="ti ti-tag"></i>Code</th><th><i class="ti ti-category"></i>Type</th><th><i class="ti ti-percentage"></i>Value</th><th><i class="ti ti-repeat"></i>Uses</th><th><i class="ti ti-circle-check"></i>Status</th><th><i class="ti ti-tool"></i>Actions</th></tr></thead>
            <tbody id="discounts-table"></tbody>
          </table>
        </div>
      </div>

      <!-- STORE SETTINGS -->
      <div class="admin-section" id="section-store">
        <div class="admin-page-title"><i class="ti ti-adjustments-horizontal"></i> Store Settings</div>
        <div style="max-width:600px;display:flex;flex-direction:column;gap:1.5rem">
          <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.5rem">
            <h3 style="font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-bottom:1.25rem;display:flex;align-items:center;gap:6px"><i class="ti ti-speakerphone"></i> Announcement Bar</h3>
            <div class="field"><label><i class="ti ti-message-2"></i> Message</label><input type="text" id="setting-announcement" placeholder="Free shipping on orders over $75"></div>
            <div class="field">
              <label><i class="ti ti-palette"></i> Background Color</label>
              <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:6px" id="bar-colors">
                <div class="color-swatch selected" style="background:#0A0A0A" data-color="#0A0A0A" onclick="selectBarColor(this)"></div>
                <div class="color-swatch" style="background:#C0392B" data-color="#C0392B" onclick="selectBarColor(this)"></div>
                <div class="color-swatch" style="background:#185FA5" data-color="#185FA5" onclick="selectBarColor(this)"></div>
                <div class="color-swatch" style="background:#2D7A2D" data-color="#2D7A2D" onclick="selectBarColor(this)"></div>
                <div class="color-swatch" style="background:#6B3FA0" data-color="#6B3FA0" onclick="selectBarColor(this)"></div>
                <div class="color-swatch" style="background:#6B6B6B" data-color="#6B6B6B" onclick="selectBarColor(this)"></div>
              </div>
            </div>
            <button class="btn btn-dark btn-sm" onclick="saveSettings()"><i class="ti ti-device-floppy"></i> Save Changes</button>
          </div>
          <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.5rem">
            <h3 style="font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-bottom:1.25rem;display:flex;align-items:center;gap:6px"><i class="ti ti-typography"></i> Store Branding</h3>
            <div class="field"><label><i class="ti ti-building-store"></i> Store Name</label><input type="text" id="setting-name" value="ShopForge"></div>
            <div class="field"><label><i class="ti ti-headline"></i> Hero Headline</label><input type="text" id="setting-tagline" value="Curated for everyday living"></div>
            <div class="field"><label><i class="ti ti-text-size"></i> Hero Subtitle</label><input type="text" id="setting-subtitle" value="Premium goods, thoughtfully selected for modern life"></div>
            <button class="btn btn-dark btn-sm" onclick="saveBranding()"><i class="ti ti-device-floppy"></i> Save Branding</button>
          </div>
          <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.5rem">
            <h3 style="font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.5rem;display:flex;align-items:center;gap:6px"><i class="ti ti-alert-triangle" style="color:var(--danger)"></i> Danger Zone</h3>
            <p style="font-size:13px;color:var(--muted);margin-bottom:1rem">These actions cannot be undone.</p>
            <button class="btn btn-danger btn-sm" onclick="resetStore()"><i class="ti ti-trash"></i> Reset All Data</button>
          </div>
        </div>
      </div>

      <!-- THEME & FONTS -->
      <div class="admin-section" id="section-theme">
        <div class="admin-page-title"><i class="ti ti-palette"></i> Theme &amp; Fonts</div>
        <div style="max-width:640px;display:flex;flex-direction:column;gap:1.5rem">
          <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.5rem">
            <h3 style="font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-bottom:1.25rem;display:flex;align-items:center;gap:6px"><i class="ti ti-color-swatch"></i> Color Scheme</h3>
            <div class="field">
              <label><i class="ti ti-layout"></i> Background Color</label>
              <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:6px">
                <div class="color-swatch selected" style="background:#FFFFFF;border-color:#ccc" data-color="#FFFFFF" data-target="bg" onclick="selectThemeColor(this,'bg')"></div>
                <div class="color-swatch" style="background:#F5F5F0" data-color="#F5F5F0" data-target="bg" onclick="selectThemeColor(this,'bg')"></div>
                <div class="color-swatch" style="background:#0A0A0A" data-color="#0A0A0A" data-target="bg" onclick="selectThemeColor(this,'bg')"></div>
                <div class="color-swatch" style="background:#1A1A2E" data-color="#1A1A2E" data-target="bg" onclick="selectThemeColor(this,'bg')"></div>
                <input type="color" value="#FFFFFF" id="custom-bg-color" oninput="applyCustomColor('bg',this.value)" style="width:28px;height:28px;border:none;padding:0;cursor:pointer;border-radius:50%">
                <span style="font-size:11px;color:var(--muted)">Custom</span>
              </div>
            </div>
            <div class="field">
              <label><i class="ti ti-paint"></i> Accent / Text Color</label>
              <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:6px">
                <div class="color-swatch selected" style="background:#0A0A0A" data-color="#0A0A0A" data-target="accent" onclick="selectThemeColor(this,'accent')"></div>
                <div class="color-swatch" style="background:#C0392B" data-color="#C0392B" data-target="accent" onclick="selectThemeColor(this,'accent')"></div>
                <div class="color-swatch" style="background:#185FA5" data-color="#185FA5" data-target="accent" onclick="selectThemeColor(this,'accent')"></div>
                <div class="color-swatch" style="background:#2D5016" data-color="#2D5016" data-target="accent" onclick="selectThemeColor(this,'accent')"></div>
                <div class="color-swatch" style="background:#6B3FA0" data-color="#6B3FA0" data-target="accent" onclick="selectThemeColor(this,'accent')"></div>
                <div class="color-swatch" style="background:#B8860B" data-color="#B8860B" data-target="accent" onclick="selectThemeColor(this,'accent')"></div>
                <input type="color" value="#0A0A0A" id="custom-accent-color" oninput="applyCustomColor('accent',this.value)" style="width:28px;height:28px;border:none;padding:0;cursor:pointer;border-radius:50%">
                <span style="font-size:11px;color:var(--muted)">Custom</span>
              </div>
            </div>
          </div>
          <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.5rem">
            <h3 style="font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-bottom:1.25rem;display:flex;align-items:center;gap:6px"><i class="ti ti-typography"></i> Heading Font</h3>
            <div style="display:flex;flex-wrap:wrap;gap:8px" id="heading-fonts">
              <div class="font-option selected" style="font-family:'Playfair Display',serif" data-font="'Playfair Display',serif" onclick="selectFont(this,'heading')">Playfair Display</div>
              <div class="font-option" style="font-family:'Cormorant Garamond',serif" data-font="'Cormorant Garamond',serif" onclick="selectFont(this,'heading')">Cormorant</div>
              <div class="font-option" style="font-family:'Oswald',sans-serif" data-font="'Oswald',sans-serif" onclick="selectFont(this,'heading')">Oswald</div>
              <div class="font-option" style="font-family:'Bebas Neue',cursive" data-font="'Bebas Neue',cursive" onclick="selectFont(this,'heading')">Bebas Neue</div>
              <div class="font-option" style="font-family:'DM Sans',sans-serif" data-font="'DM Sans',sans-serif" onclick="selectFont(this,'heading')">DM Sans</div>
              <div class="font-option" style="font-family:'Lato',sans-serif" data-font="'Lato',sans-serif" onclick="selectFont(this,'heading')">Lato</div>
            </div>
            <div id="heading-font-preview" style="margin-top:1rem;font-family:'Playfair Display',serif;font-size:2rem;font-weight:400;font-style:italic">The quick brown fox</div>
          </div>
          <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.5rem">
            <h3 style="font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-bottom:1.25rem;display:flex;align-items:center;gap:6px"><i class="ti ti-text-size"></i> Body Font</h3>
            <div style="display:flex;flex-wrap:wrap;gap:8px" id="body-fonts">
              <div class="font-option selected" style="font-family:'DM Sans',sans-serif" data-font="'DM Sans',sans-serif" onclick="selectFont(this,'body')">DM Sans</div>
              <div class="font-option" style="font-family:'Lato',sans-serif" data-font="'Lato',sans-serif" onclick="selectFont(this,'body')">Lato</div>
              <div class="font-option" style="font-family:'Oswald',sans-serif" data-font="'Oswald',sans-serif" onclick="selectFont(this,'body')">Oswald</div>
              <div class="font-option" style="font-family:'Playfair Display',serif" data-font="'Playfair Display',serif" onclick="selectFont(this,'body')">Playfair Display</div>
            </div>
            <div id="body-font-preview" style="margin-top:1rem;font-family:'DM Sans',sans-serif;font-size:14px;line-height:1.6;color:var(--muted)">Body text looks like this — clear and easy to read.</div>
          </div>
          <button class="btn btn-dark" onclick="saveTheme()"><i class="ti ti-device-floppy"></i> Save &amp; Apply Theme</button>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- PRODUCT FORM MODAL -->
<div id="product-form-overlay" style="display:none" class="modal-overlay" onclick="closeProductForm(event)">
  <div class="modal-box" onclick="event.stopPropagation()">
    <h2 id="product-form-title"><i class="ti ti-package"></i> Add Product</h2>
    <div class="field">
      <label><i class="ti ti-photo"></i> Product Image</label>
      <div class="img-upload-area" id="img-upload-area">
        <input type="file" id="pf-image-file" accept="image/*" onchange="handleImageUpload(event)">
        <div id="img-upload-placeholder">
          <i class="ti ti-photo-plus" style="font-size:2.5rem;opacity:.4;display:block;margin-bottom:.5rem"></i>
          <div style="font-size:14px;color:var(--muted)">Click to upload a photo</div>
          <div style="font-size:12px;color:var(--muted);margin-top:4px">JPG, PNG, WEBP up to 5MB</div>
        </div>
        <img id="img-preview" class="img-preview" alt="Product preview">
      </div>
      <div style="display:flex;gap:8px;margin-top:.5rem;align-items:center">
        <span style="font-size:12px;color:var(--muted)">Or use an emoji:</span>
        <button class="btn btn-xs" style="border:1px solid var(--border)" onclick="toggleEmojiSection()"><i class="ti ti-mood-smile"></i> Choose Emoji</button>
        <button class="btn btn-xs btn-danger" id="clear-img-btn" onclick="clearImage()" style="display:none"><i class="ti ti-trash"></i> Remove</button>
      </div>
    </div>
    <div id="emoji-section" style="display:none;margin-top:.5rem">
      <div style="text-align:center;margin-bottom:.5rem"><div class="selected-emoji" id="selected-emoji-display">🛍️</div></div>
      <div class="emoji-picker" id="emoji-picker"></div>
    </div>
    <hr class="section-divider">
    <div class="form-grid">
      <div class="field col-span-2"><label><i class="ti ti-pencil"></i> Product Name</label><input type="text" id="pf-name" placeholder="e.g. Classic Linen Shirt"></div>
      <div class="field"><label><i class="ti ti-building"></i> Brand</label><input type="text" id="pf-brand" placeholder="e.g. Studio Basics"></div>
      <div class="field"><label><i class="ti ti-folder"></i> Collection</label>
        <select id="pf-collection"><option value="clothing">Clothing</option><option value="accessories">Accessories</option><option value="home">Home</option></select>
      </div>
      <div class="field"><label><i class="ti ti-currency-dollar"></i> Price ($)</label><input type="number" id="pf-price" placeholder="49.99" step="0.01" min="0"></div>
      <div class="field"><label><i class="ti ti-tag"></i> Compare Price ($) — optional</label><input type="number" id="pf-compare" placeholder="69.99" step="0.01" min="0"></div>
      <div class="field col-span-2"><label><i class="ti ti-align-left"></i> Description</label><textarea id="pf-desc" placeholder="Short product description…"></textarea></div>
      <div class="field col-span-2"><label><i class="ti ti-list-details"></i> Details</label><textarea id="pf-details" placeholder="Material, dimensions, care instructions…"></textarea></div>
      <div class="field"><label><i class="ti ti-box"></i> Stock Quantity</label><input type="number" id="pf-stock" placeholder="100" min="0"></div>
      <div class="field"><label><i class="ti ti-ruler"></i> Sizes (comma-separated)</label><input type="text" id="pf-sizes" placeholder="XS, S, M, L, XL"></div>
      <div class="field col-span-2"><label><i class="ti ti-hash"></i> Tags (comma-separated)</label><input type="text" id="pf-tags" placeholder="new, featured, sale"></div>
    </div>
    <div style="display:flex;gap:.75rem;justify-content:flex-end;margin-top:1.5rem">
      <button class="btn" style="border:1px solid var(--border)" onclick="closeProductForm()"><i class="ti ti-x"></i> Cancel</button>
      <button class="btn btn-dark" onclick="saveProduct()"><i class="ti ti-device-floppy"></i> Save Product</button>
    </div>
    <input type="hidden" id="pf-id">
  </div>
</div>

<!-- DISCOUNT FORM -->
<div id="discount-form-overlay" style="display:none" class="modal-overlay" onclick="closeDiscountForm(event)">
  <div class="modal-box" onclick="event.stopPropagation()" style="max-width:420px">
    <h2><i class="ti ti-tag"></i> Add Discount Code</h2>
    <div class="field"><label><i class="ti ti-ticket"></i> Code</label><input type="text" id="df-code" placeholder="SUMMER20" oninput="this.value=this.value.toUpperCase()"></div>
    <div class="field"><label><i class="ti ti-category"></i> Type</label>
      <select id="df-type"><option value="percent">Percentage (%)</option><option value="fixed">Fixed Amount ($)</option><option value="free_ship">Free Shipping</option></select>
    </div>
    <div class="field"><label><i class="ti ti-percentage"></i> Value</label><input type="number" id="df-value" placeholder="20" min="0"></div>
    <div class="field"><label><i class="ti ti-repeat"></i> Usage Limit (0 = unlimited)</label><input type="number" id="df-limit" placeholder="0" min="0"></div>
    <div style="display:flex;gap:.75rem;justify-content:flex-end;margin-top:1.5rem">
      <button class="btn" style="border:1px solid var(--border)" onclick="closeDiscountForm()"><i class="ti ti-x"></i> Cancel</button>
      <button class="btn btn-dark" onclick="saveDiscount()"><i class="ti ti-device-floppy"></i> Save</button>
    </div>
  </div>
</div>

<div id="toast"><i class="ti ti-check"></i><span id="toast-msg"></span></div>

<script>
const EMOJIS=['🧴','👕','👟','👜','🧣','☕','🕯️','📚','🌿','🧺','🍵','🧦','👒','💄','🛁','🪴','🧼','🍋','🧶','🎒','🌸','🪑','🥗','🧲','🍫','🎨','🧁','🌙','🦋','🧘','💎','🌊','🧪','🎸','📷','🏺','🪞','🛋️','🌾','🥂'];

let store={
  products:[],orders:[],customers:[],
  discounts:[
    {id:'d1',code:'WELCOME10',type:'percent',value:10,limit:0,uses:0,active:true},
    {id:'d2',code:'FREESHIP',type:'free_ship',value:0,limit:100,uses:0,active:true}
  ],
  settings:{announcement:'Free shipping on orders over $75 · Use code WELCOME10 for 10% off',barColor:'#0A0A0A',storeName:'ShopForge',tagline:'Curated for everyday living',subtitle:'Premium goods, thoughtfully selected for modern life'},
  theme:{bg:'#FFFFFF',accent:'#0A0A0A',headingFont:"'Playfair Display',serif",bodyFont:"'DM Sans',sans-serif"},
  payoutInfo:{bank:'',email:'',cashapp:'',notes:''}
};
let cart=[];
let currentFilter='all';
let currentSort='featured';
let editingProductId=null;
let selectedEmoji='🛍️';
let selectedBarColor='#0A0A0A';
let currentImageDataUrl=null;

function loadStore(){
  try{
    const saved=localStorage.getItem('shopforge_v4');
    if(saved){store=JSON.parse(saved);}
    if(!store.products)store.products=[];
    if(!store.orders)store.orders=[];
    if(!store.customers)store.customers=[];
    if(!store.discounts)store.discounts=[];
    if(!store.theme)store.theme={bg:'#FFFFFF',accent:'#0A0A0A',headingFont:"'Playfair Display',serif",bodyFont:"'DM Sans',sans-serif"};
    if(!store.payoutInfo)store.payoutInfo={bank:'',email:'',cashapp:'',notes:''};
  }catch(e){console.error(e);}
}
function saveStoreData(){try{localStorage.setItem('shopforge_v4',JSON.stringify(store));}catch(e){}}

function productMedia(p){
  if(p.image)return`<img src="${p.image}" alt="${p.name}" style="width:100%;height:100%;object-fit:cover">`;
  return p.emoji||'📦';
}

// ── MOBILE NAV ──
function toggleMobileNav(){
  const nav=document.getElementById('mobile-nav');
  const btn=document.getElementById('hamburger-btn');
  if(nav.classList.contains('open')){closeMobileNav();}
  else{nav.classList.add('open');btn.classList.add('open');document.body.style.overflow='hidden';}
}
function closeMobileNav(){
  document.getElementById('mobile-nav').classList.remove('open');
  document.getElementById('hamburger-btn').classList.remove('open');
  document.body.style.overflow='';
}

// ── RENDER PRODUCTS ──
function renderProducts(){
  const grid=document.getElementById('product-grid');
  const noP=document.getElementById('no-products');
  let prods=store.products.filter(p=>p.active!==false);
  if(!prods.length){
    grid.innerHTML=`<div class="empty-store" style="grid-column:1/-1">
      <i class="ti ti-package" style="font-size:4rem;display:block;margin-bottom:1rem;opacity:.15"></i>
      <h3>No products yet</h3>
      <p>Log in as admin to add your first product to the store.</p>
    </div>`;
    noP.style.display='none';return;
  }
  if(currentFilter==='sale')prods=prods.filter(p=>p.compare||p.tags?.includes('sale'));
  else if(currentFilter!=='all')prods=prods.filter(p=>p.collection===currentFilter);
  if(currentSort==='price-asc')prods.sort((a,b)=>a.price-b.price);
  else if(currentSort==='price-desc')prods.sort((a,b)=>b.price-a.price);
  else if(currentSort==='name')prods.sort((a,b)=>a.name.localeCompare(b.name));
  if(!prods.length){grid.innerHTML='';noP.style.display='block';return;}
  noP.style.display='none';
  grid.innerHTML=prods.map(p=>`
    <div class="product-card" onclick="openProduct('${p.id}')">
      ${p.tags?.includes('new')?'<div class="product-badge">New</div>':''}
      ${(p.compare||p.tags?.includes('sale'))&&!p.tags?.includes('new')?'<div class="product-badge sale">Sale</div>':''}
      <div class="product-img">${productMedia(p)}</div>
      <div class="product-info">
        <div class="product-brand">${p.brand||''}</div>
        <div class="product-name">${p.name}</div>
        <div class="product-price">
          <span class="price">$${p.price.toFixed(2)}</span>
          ${p.compare?`<span class="price-original">$${p.compare.toFixed(2)}</span>`:''}
        </div>
        <div class="product-stars">${'★'.repeat(Math.round(p.rating||4.5))}${'☆'.repeat(5-Math.round(p.rating||4.5))} <span style="opacity:.5">(${p.reviews||0})</span></div>
      </div>
      <button class="quick-add" onclick="event.stopPropagation();quickAdd('${p.id}')">
        <i class="ti ti-shopping-bag" style="font-size:13px;vertical-align:middle"></i> Quick Add
      </button>
    </div>
  `).join('');
}
function filterCollection(col){
  currentFilter=col;
  const labels={all:'All Products',clothing:'Clothing',accessories:'Accessories',home:'Home & Living',sale:'Sale Items'};
  const subs={all:'Explore our full range',clothing:'Tops, bottoms, knitwear and more',accessories:'Bags, hats, and finishing touches',home:'For the spaces you love',sale:'Great products at better prices'};
  document.getElementById('section-heading').textContent=labels[col]||'Products';
  document.getElementById('section-sub').textContent=subs[col]||'';
  renderProducts();scrollToProducts();
}
function sortProducts(){currentSort=document.getElementById('sort-select').value;renderProducts();}
function scrollToProducts(){document.getElementById('products-section').scrollIntoView({behavior:'smooth'});}

// ── CART ──
function openCart(){
  document.getElementById('cart-overlay').classList.add('open');
  document.getElementById('cart-drawer').classList.add('open');
  document.body.style.overflow='hidden';
  renderCart();
}
function closeCart(){
  document.getElementById('cart-overlay').classList.remove('open');
  document.getElementById('cart-drawer').classList.remove('open');
  document.body.style.overflow='';
}
function quickAdd(id){const p=store.products.find(x=>x.id===id);if(p){addToCart(p,1);showToast(`${p.name} added to cart`);}}
function addToCart(p,qty=1,variant=''){
  const key=p.id+(variant?'-'+variant:'');
  const ex=cart.find(x=>x.key===key);
  if(ex)ex.qty+=qty;
  else cart.push({key,id:p.id,name:p.name,price:p.price,emoji:p.emoji||'📦',image:p.image||null,qty,variant});
  updateCartCount();
}
function removeFromCart(key){cart=cart.filter(x=>x.key!==key);updateCartCount();renderCart();}
function changeQty(key,delta){
  const item=cart.find(x=>x.key===key);
  if(item){item.qty+=delta;if(item.qty<=0)removeFromCart(key);else renderCart();}
  updateCartCount();
}
function updateCartCount(){
  const total=cart.reduce((s,i)=>s+i.qty,0);
  const badge=document.getElementById('cart-count');
  badge.textContent=total;badge.style.display=total>0?'flex':'none';
}
function renderCart(){
  const list=document.getElementById('cart-items-list');
  const footer=document.getElementById('cart-footer');
  const count=document.getElementById('cart-item-count');
  if(!cart.length){
    list.innerHTML='<div class="cart-empty"><i class="ti ti-shopping-bag" style="font-size:3rem;display:block;margin-bottom:.75rem;opacity:.2"></i>Your cart is empty</div>';
    footer.style.display='none';count.textContent='';return;
  }
  count.textContent=`(${cart.reduce((s,i)=>s+i.qty,0)} items)`;
  const total=cart.reduce((s,i)=>s+i.price*i.qty,0);
  list.innerHTML=cart.map(item=>`
    <div class="cart-item">
      <div class="cart-item-img">${item.image?`<img src="${item.image}" alt="${item.name}">`:item.emoji}</div>
      <div class="cart-item-info">
        <div class="cart-item-name">${item.name}${item.variant?' — '+item.variant:''}</div>
        <div class="cart-item-price">$${item.price.toFixed(2)} each</div>
        <div class="cart-qty">
          <button class="qty-btn" onclick="changeQty('${item.key}',-1)">−</button>
          <span class="qty-num">${item.qty}</span>
          <button class="qty-btn" onclick="changeQty('${item.key}',1)">+</button>
          <button style="margin-left:auto;background:none;border:none;color:var(--muted);cursor:pointer;font-size:20px;padding:4px 8px" onclick="removeFromCart('${item.key}')"><i class="ti ti-trash"></i></button>
        </div>
      </div>
    </div>
  `).join('');
  document.getElementById('cart-total').textContent='$'+total.toFixed(2);
  document.getElementById('cart-total-btn').textContent='$'+total.toFixed(2);
  footer.style.display='block';
  document.getElementById('payment-error').style.display='none';
}

// ── CARD FORMAT HELPERS ──
function formatCard(input){
  let v=input.value.replace(/\D/g,'').substring(0,16);
  input.value=v.replace(/(.{4})/g,'$1 ').trim();
}
function formatExp(input){
  let v=input.value.replace(/\D/g,'');
  if(v.length>=2)v=v.substring(0,2)+' / '+v.substring(2,4);
  input.value=v;
}
function showPaymentError(msg){
  const el=document.getElementById('payment-error');
  document.getElementById('payment-error-msg').textContent=msg;
  el.style.display='flex';
  el.scrollIntoView({behavior:'smooth',block:'nearest'});
}
function luhn(n){
  let s=0,alt=false;
  for(let i=n.length-1;i>=0;i--){
    let d=parseInt(n[i]);
    if(alt){d*=2;if(d>9)d-=9;}
    s+=d;alt=!alt;
  }
  return s%10===0;
}
function fieldErr(id){document.getElementById(id).classList.add('error');}
function clearErrors(){
  document.querySelectorAll('.shipping-form input,.shipping-form select,.card-form input').forEach(i=>i.classList.remove('error'));
  document.getElementById('payment-error').style.display='none';
}

// ── CHECKOUT ──
function checkout(){
  clearErrors();
  const shFirst=document.getElementById('sh-first').value.trim();
  const shLast=document.getElementById('sh-last').value.trim();
  const shStreet=document.getElementById('sh-street').value.trim();
  const shCity=document.getElementById('sh-city').value.trim();
  const shState=document.getElementById('sh-state').value.trim();
  const shZip=document.getElementById('sh-zip').value.trim();
  const shCountry=document.getElementById('sh-country').value.trim();
  const shPhone=document.getElementById('sh-


  document.getElementById('earnings-breakdown').innerHTML=`
    <div class="earnings-item"><div class="earnings-item-label"><i class="ti ti-circle-check"></i> Fulfilled</div><div class="earnings-item-val">$${fulfilled.toFixed(2)}</div></div>
    <div class="earnings-item"><div class="earnings-item-label"><i class="ti ti-clock"></i> Pending</div><div class="earnings-item-val">$${pending.toFixed(2)}</div></div>
    <div class="earnings-item"><div class="earnings-item-label"><i class="ti ti-receipt"></i> Avg Order</div><div class="earnings-item-val">$${avgOrder.toFixed(2)}</div></div>
    <div class="earnings-item"><div class="earnings-item-label"><i class="ti ti-clipboard-list"></i> Total Orders</div><div class="earnings-item-val">${paidOrders.length}</div></div>
  `;
  if(store.payoutInfo){
    document.getElementById('payout-bank').value=store.payoutInfo.bank||'';
    document.getElementById('payout-email').value=store.payoutInfo.email||'';
    document.getElementById('payout-cashapp').value=store.payoutInfo.cashapp||'';
    document.getElementById('payout-notes').value=store.payoutInfo.notes||'';
  }
  document.getElementById('earnings-table').innerHTML=paidOrders.map(o=>`
    <tr>
      <td style="font-weight:600">${o.id}</td>
      <td>${o.date}</td>
      <td>${o.customer}</td>
      <td style="color:var(--success);font-weight:600">+$${parseFloat(o.total).toFixed(2)}</td>
      <td><span class="badge ${o.status==='fulfilled'?'badge-green':o.status==='pending'?'badge-amber':'badge-gray'}">${o.status}</span></td>
    </tr>`).join('')||'<tr><td colspan="5" style="text-align:center;color:var(--muted);padding:2rem">No transactions yet.</td></tr>';
}

async function savePayoutInfo(){
  store.payoutInfo={bank:document.getElementById('payout-bank').value.trim(),email:document.getElementById('payout-email').value.trim(),cashapp:document.getElementById('payout-cashapp').value.trim(),notes:document.getElementById('payout-notes').value.trim()};
  await saveStoreData();showToast('Payout info saved!');
}

function renderProductsAdmin(){
  document.getElementById('products-admin-table').innerHTML=store.products.length?store.products.map(p=>`
    <tr>
      <td><span style="margin-right:8px">${p.image?'🖼️':p.emoji}</span><strong>${p.name}</strong></td>
      <td><span class="badge badge-gray">${p.collection}</span></td>
      <td>$${p.price.toFixed(2)}${p.compare?` <span style="text-decoration:line-through;color:var(--muted);font-size:12px">$${p.compare.toFixed(2)}</span>`:''}</td>
      <td>${p.stock??'—'}</td>
      <td><span class="badge ${p.active!==false?'badge-green':'badge-red'}">${p.active!==false?'Active':'Draft'}</span></td>
      <td><div style="display:flex;gap:6px">
        <button class="btn btn-xs" style="border:1px solid var(--border)" onclick="editProduct('${p.id}')"><i class="ti ti-edit"></i> Edit</button>
        <button class="btn btn-xs" style="border:1px solid var(--border)" onclick="toggleProductActive('${p.id}')">${p.active!==false?'<i class="ti ti-eye-off"></i>':'<i class="ti ti-eye"></i>'}</button>
        <button class="btn btn-xs btn-danger" onclick="deleteProduct('${p.id}')"><i class="ti ti-trash"></i></button>
      </div></td>
    </tr>`).join(''):'<tr><td colspan="6" style="text-align:center;color:var(--muted);padding:2rem">No products yet. Click "Add Product" to get started.</td></tr>';
}
async function toggleProductActive(id){
  const p=store.products.find(x=>x.id===id);
  if(p){p.active=p.active===false?true:false;await saveStoreData();renderProductsAdmin();renderProducts();showToast(p.active?'Product activated':'Product deactivated');}
}
async function deleteProduct(id){
  if(confirm('Delete this product?')){
    store.products=store.products.filter(p=>p.id!==id);
    await saveStoreData();renderProductsAdmin();renderProducts();showToast('Product deleted');
  }
}

function formatShipAddress(order){
  const s=order.shippingAddress;
  if(!s)return`<span style="color:var(--muted);font-size:12px">—</span>`;
  const apt=s.apt?`, ${s.apt}`:'';
  return`<div class="ship-info-box">
    <strong>Ship To</strong>
    ${s.name}<br>${s.street}${apt}<br>
    ${s.city}, ${s.state} ${s.zip}<br>
    ${s.country}<br>
    <span style="color:var(--muted)">${s.phone}</span><br>
    <span style="color:var(--muted)">${s.email}</span>
  </div>`;
}

function renderOrdersAdmin(){
  const statuses=['fulfilled','pending','processing','refunded'];
  document.getElementById('orders-table').innerHTML=store.orders.length?store.orders.map(o=>`
    <tr>
      <td style="font-weight:500">${o.id}</td>
      <td style="white-space:nowrap">${o.date}</td>
      <td>${o.customer}</td>
      <td>${formatShipAddress(o)}</td>
      <td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${Array.isArray(o.items)?o.items.join(', '):o.items}</td>
      <td>$${parseFloat(o.total).toFixed(2)}</td>
      <td>${o.paid!==false?'<span class="badge badge-green"><i class="ti ti-credit-card" style="font-size:11px"></i> Paid</span>':'<span class="badge badge-red">Unpaid</span>'}</td>
      <td><span class="badge ${o.status==='fulfilled'?'badge-green':o.status==='pending'?'badge-amber':o.status==='refunded'?'badge-red':'badge-gray'}">${o.status}</span></td>
      <td><select style="font-size:12px;padding:4px 8px;border:1px solid var(--border);border-radius:var(--radius);background:var(--bg);font-family:inherit" onchange="updateOrderStatus('${o.id}',this.value)">
        ${statuses.map(s=>`<option value="${s}"${o.status===s?' selected':''}>${s}</option>`).join('')}
      </select></td>
    </tr>`).join(''):'<tr><td colspan="9" style="text-align:center;color:var(--muted);padding:2rem">No orders yet.</td></tr>';
}
async function updateOrderStatus(id,status){
  const o=store.orders.find(x=>x.id===id);
  if(o){o.status=status;await saveStoreData();showToast('Order updated');}
}

function renderCustomersAdmin(){
  document.getElementById('customers-table').innerHTML=store.customers.length?store.customers.map(c=>`
    <tr>
      <td style="font-weight:500"><i class="ti ti-user-circle" style="font-size:16px;opacity:.4;margin-right:6px;vertical-align:middle"></i>${c.name}</td>
      <td style="color:var(--muted)">${c.email}</td>
      <td>${c.orders}</td>
      <td style="font-weight:500">$${c.spent}</td>
      <td style="color:var(--muted)">${c.joined}</td>
    </tr>`).join(''):'<tr><td colspan="5" style="text-align:center;color:var(--muted);padding:2rem">No customers yet.</td></tr>';
}

function renderDiscountsAdmin(){
  document.getElementById('discounts-table').innerHTML=store.discounts.map(d=>`
    <tr>
      <td style="font-weight:600;font-family:monospace;font-size:13px"><i class="ti ti-ticket" style="font-size:13px;opacity:.5;margin-right:4px"></i>${d.code}</td>
      <td>${d.type==='percent'?'Percentage':d.type==='fixed'?'Fixed Amount':'Free Shipping'}</td>
      <td>${d.type==='percent'?d.value+'%':d.type==='fixed'?'$'+d.value:'Free'}</td>
      <td>${d.uses}${d.limit>0?' / '+d.limit:''}</td>
      <td><span class="badge ${d.active?'badge-green':'badge-gray'}">${d.active?'Active':'Inactive'}</span></td>
      <td><div style="display:flex;gap:6px">
        <button class="btn btn-xs" style="border:1px solid var(--border)" onclick="toggleDiscount('${d.id}')">${d.active?'<i class="ti ti-ban"></i>':'<i class="ti ti-check"></i>'}</button>
        <button class="btn btn-xs btn-danger" onclick="deleteDiscount('${d.id}')"><i class="ti ti-trash"></i></button>
      </div></td>
    </tr>`).join('');
}
async function toggleDiscount(id){const d=store.discounts.find(x=>x.id===id);if(d){d.active=!d.active;await saveStoreData();renderDiscountsAdmin();}}
async function deleteDiscount(id){store.discounts=store.discounts.filter(d=>d.id!==id);await saveStoreData();renderDiscountsAdmin();}

// ── IMAGE UPLOAD ──
function handleImageUpload(event){
  const file=event.target.files[0];if(!file)return;
  if(file.size>5*1024*1024){showToast('Image must be under 5MB');return;}
  const reader=new FileReader();
  reader.onload=e=>{
    currentImageDataUrl=e.target.result;
    document.getElementById('img-preview').src=currentImageDataUrl;
    document.getElementById('img-preview').style.display='block';
    document.getElementById('img-upload-placeholder').style.display='none';
    document.getElementById('clear-img-btn').style.display='inline-flex';
    document.getElementById('emoji-section').style.display='none';
  };
  reader.readAsDataURL(file);
}
function clearImage(){
  currentImageDataUrl=null;
  document.getElementById('img-preview').style.display='none';
  document.getElementById('img-preview').src='';
  document.getElementById('img-upload-placeholder').style.display='block';
  document.getElementById('clear-img-btn').style.display='none';
  document.getElementById('pf-image-file').value='';
}
function toggleEmojiSection(){const s=document.getElementById('emoji-section');s.style.display=s.style.display==='none'?'block':'none';}

// ── PRODUCT FORM ──
function openProductForm(){
  editingProductId=null;selectedEmoji='🛍️';currentImageDataUrl=null;
  document.getElementById('product-form-title').innerHTML='<i class="ti ti-plus"></i> Add Product';
  document.getElementById('pf-id').value='';
  ['name','brand','desc','details','sizes','tags'].forEach(f=>document.getElementById('pf-'+f).value='');
  document.getElementById('pf-price').value='';document.getElementById('pf-compare').value='';document.getElementById('pf-stock').value='';
  document.getElementById('pf-collection').value='clothing';
  document.getElementById('selected-emoji-display').textContent='🛍️';
  clearImage();document.getElementById('emoji-section').style.display='none';
  buildEmojiPicker();document.getElementById('product-form-overlay').style.display='flex';
}
function editProduct(id){
  const p=store.products.find(x=>x.id===id);if(!p)return;
  editingProductId=id;selectedEmoji=p.emoji||'📦';currentImageDataUrl=p.image||null;
  document.getElementById('product-form-title').innerHTML='<i class="ti ti-edit"></i> Edit Product';
  document.getElementById('pf-id').value=id;
  document.getElementById('pf-name').value=p.name;document.getElementById('pf-brand').value=p.brand||'';
  document.getElementById('pf-collection').value=p.collection;document.getElementById('pf-price').value=p.price;
  document.getElementById('pf-compare').value=p.compare||'';document.getElementById('pf-desc').value=p.desc||'';
  document.getElementById('pf-details').value=p.details||'';document.getElementById('pf-stock').value=p.stock||'';
  document.getElementById('pf-sizes').value=Array.isArray(p.sizes)?p.sizes.join(', '):'';
  document.getElementById('pf-tags').value=Array.isArray(p.tags)?p.tags.join(', '):'';
  document.getElementById('selected-emoji-display').textContent=selectedEmoji;
  if(p.image){document.getElementById('img-preview').src=p.image;document.getElementById('img-preview').style.display='block';document.getElementById('img-upload-placeholder').style.display='none';document.getElementById('clear-img-btn').style.display='inline-flex';}
  else clearImage();
  document.getElementById('emoji-section').style.display='none';
  buildEmojiPicker();document.getElementById('product-form-overlay').style.display='flex';
}
function closeProductForm(e){if(!e||e.target===document.getElementById('product-form-overlay'))document.getElementById('product-form-overlay').style.display='none';}
async function saveProduct(){
  const name=document.getElementById('pf-name').value.trim();
  const price=parseFloat(document.getElementById('pf-price').value);
  if(!name||isNaN(price)){showToast('Name and price are required');return;}
  const prod={
    id:editingProductId||('p'+Date.now()),name,
    brand:document.getElementById('pf-brand').value.trim(),
    collection:document.getElementById('pf-collection').value,
    price,compare:parseFloat(document.getElementById('pf-compare').value)||null,
    emoji:selectedEmoji,image:currentImageDataUrl,
    desc:document.getElementById('pf-desc').value.trim(),
    details:document.getElementById('pf-details').value.trim(),
    stock:parseInt(document.getElementById('pf-stock').value)||0,
    sizes:document.getElementById('pf-sizes').value.split(',').map(s=>s.trim()).filter(Boolean),
    tags:document.getElementById('pf-tags').value.split(',').map(s=>s.trim()).filter(Boolean),
    rating:4.5,reviews:0,active:true
  };
  if(editingProductId){
    const i=store.products.findIndex(p=>p.id===editingProductId);
    if(i>-1){prod.rating=store.products[i].rating;prod.reviews=store.products[i].reviews;store.products[i]=prod;}
  }else{
    store.products.push(prod);
  }
  await saveStoreData();
  renderProductsAdmin();
  renderProducts();
  closeProductForm();
  showToast(editingProductId?'Product updated! ✓':'Product added! ✓');
}
function buildEmojiPicker(){
  document.getElementById('emoji-picker').innerHTML=EMOJIS.map(e=>`<div class="emoji-opt${e===selectedEmoji?' selected':''}" onclick="pickEmoji(this,'${e}')">${e}</div>`).join('');
}
function pickEmoji(el,e){
  document.querySelectorAll('.emoji-opt').forEach(x=>x.classList.remove('selected'));
  el.classList.add('selected');selectedEmoji=e;document.getElementById('selected-emoji-display').textContent=e;
}

// ── DISCOUNT FORM ──
function openDiscountForm(){document.getElementById('discount-form-overlay').style.display='flex';}
function closeDiscountForm(e){if(!e||e.target===document.getElementById('discount-form-overlay'))document.getElementById('discount-form-overlay').style.display='none';}
async function saveDiscount(){
  const code=document.getElementById('df-code').value.trim();
  if(!code){showToast('Code required');return;}
  store.discounts.push({id:'d'+Date.now(),code,type:document.getElementById('df-type').value,value:parseFloat(document.getElementById('df-value').value)||0,limit:parseInt(document.getElementById('df-limit').value)||0,uses:0,active:true});
  await saveStoreData();renderDiscountsAdmin();closeDiscountForm();showToast('Discount code created!');
}

// ── STORE SETTINGS ──
let barColor='#0A0A0A';
function selectBarColor(el){document.querySelectorAll('#bar-colors .color-swatch').forEach(s=>s.classList.remove('selected'));el.classList.add('selected');barColor=el.dataset.color;}
async function saveSettings(){
  const msg=document.getElementById('setting-announcement').value.trim();
  if(msg)document.getElementById('topbar').textContent=msg;
  document.getElementById('topbar').style.background=barColor;
  store.settings.announcement=msg;store.settings.barColor=barColor;
  await saveStoreData();showToast('Settings saved!');
}
async function saveBranding(){
  const name=document.getElementById('setting-name').value.trim();
  const tag=document.getElementById('setting-tagline').value.trim();
  const sub=document.getElementById('setting-subtitle').value.trim();
  if(name){document.querySelector('.nav-logo').textContent=name;document.querySelector('.footer-brand').textContent=name;}
  if(tag)document.querySelector('#hero h1').textContent=tag;
  if(sub)document.querySelector('#hero p').textContent=sub;
  store.settings.storeName=name;store.settings.tagline=tag;store.settings.subtitle=sub;
  await saveStoreData();showToast('Branding updated!');
}
function resetStore(){
  if(confirm('Reset all products, orders, and settings?')){
    if(window.storage)window.storage.delete(STORAGE_KEY).catch(()=>{});
    try{localStorage.removeItem(STORAGE_KEY);}catch(e){}
    location.reload();
  }
}

// ── THEME ──
function selectThemeColor(el,target){
  const parent=el.closest('.field').querySelectorAll('.color-swatch');
  parent.forEach(s=>s.classList.remove('selected'));el.classList.add('selected');
  applyCustomColor(target,el.dataset.color);
}
function applyCustomColor(target,color){
  if(target==='bg'){
    document.documentElement.style.setProperty('--bg',color);
    document.documentElement.style.setProperty('--surface',shiftColor(color,-8));
    if(!store.theme)store.theme={};store.theme.bg=color;
  }else{
    document.documentElement.style.setProperty('--text',color);
    document.documentElement.style.setProperty('--accent',color);
    document.documentElement.style.setProperty('--btn-bg',color);
    if(!store.theme)store.theme={};store.theme.accent=color;
  }
}
function shiftColor(hex,amt){
  try{const r=parseInt(hex.slice(1,3),16),g=parseInt(hex.slice(3,5),16),b=parseInt(hex.slice(5,7),16);
  const nr=Math.max(0,Math.min(255,r+amt)),ng=Math.max(0,Math.min(255,g+amt)),nb=Math.max(0,Math.min(255,b+amt));
  return`#${nr.toString(16).padStart(2,'0')}${ng.toString(16).padStart(2,'0')}${nb.toString(16).padStart(2,'0')}`;}catch(e){return hex;}
}
function selectFont(el,type){
  document.getElementById(type+'-fonts').querySelectorAll('.font-option').forEach(f=>f.classList.remove('selected'));
  el.classList.add('selected');const font=el.dataset.font;
  if(type==='heading'){document.documentElement.style.setProperty('--font-heading',font);document.getElementById('heading-font-preview').style.fontFamily=font;if(!store.theme)store.theme={};store.theme.headingFont=font;}
  else{document.documentElement.style.setProperty('--font-body',font);document.body.style.fontFamily=font;document.getElementById('body-font-preview').style.fontFamily=font;if(!store.theme)store.theme={};store.theme.bodyFont=font;}
}
async function saveTheme(){await saveStoreData();showToast('Theme applied!');}

// ── TOAST ──
let toastTimer;
function showToast(msg,dur=3000){
  const t=document.getElementById('toast');
  document.getElementById('toast-msg').textContent=msg;
  t.classList.add('show');
  clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove('show'),dur);
}

// ── KEYBOARD ──
document.addEventListener('keydown',e=>{
  if(e.key==='Escape'){closeCart();closeProductModal();closeSearch();closeMobileNav();}
  if(e.key==='/'&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName)){e.preventDefault();openSearch();}
});
document.addEventListener('click',e=>{
  const nav=document.getElementById('mobile-nav');
  const hamburger=document.querySelector('.hamburger');
  if(nav.classList.contains('open')&&!nav.contains(e.target)&&!hamburger.contains(e.target)){closeMobileNav();}
});

// ── INIT ──
async function init(){
  await loadStore();
  renderProducts();
  buildEmojiPicker();
  if(store.theme){
    if(store.theme.bg)applyCustomColor('bg',store.theme.bg);
    if(store.theme.accent)applyCustomColor('accent',store.theme.accent);
    if(store.theme.headingFont)document.documentElement.style.setProperty('--font-heading',store.theme.headingFont);
    if(store.theme.bodyFont){document.documentElement.style.setProperty('--font-body',store.theme.bodyFont);document.body.style.fontFamily=store.theme.bodyFont;}
  }
  if(store.settings){
    if(store.settings.announcement){document.getElementById('topbar').textContent=store.settings.announcement;document.getElementById('setting-announcement').value=store.settings.announcement;}
    if(store.settings.barColor){document.getElementById('topbar').style.background=store.settings.barColor;barColor=store.settings.barColor;}
    if(store.settings.storeName){document.getElementById('setting-name').value=store.settings.storeName;document.querySelector('.nav-logo').textContent=store.settings.storeName;document.querySelector('.footer-brand').textContent=store.settings.storeName;}
    if(store.settings.tagline){document.getElementById('setting-tagline').value=store.settings.tagline;document.querySelector('#hero h1').textContent=store.settings.tagline;}
    if(store.settings.subtitle){document.getElementById('setting-subtitle').value=store.settings.subtitle;document.querySelector('#hero p').textContent=store.settings.subtitle;}
  }
}
init();
</script>

// ── CART ──
function openCart(){
  document.getElementById('cart-overlay').classList.add('open');
  document.getElementById('cart-drawer').classList.add('open');
  renderCart();
}
function closeCart(){
  document.getElementById('cart-overlay').classList.remove('open');
  document.getElementById('cart-drawer').classList.remove('open');
}
function quickAdd(id){const p=store.products.find(x=>x.id===id);if(p){addToCart(p,1);showToast(`${p.name} added to cart`);}}
function addToCart(p,qty=1,variant=''){
  const key=p.id+(variant?'-'+variant:'');
  const ex=cart.find(x=>x.key===key);
  if(ex)ex.qty+=qty;
  else cart.push({key,id:p.id,name:p.name,price:p.price,emoji:p.emoji||'📦',image:p.image||null,qty,variant});
  updateCartCount();
}
function removeFromCart(key){cart=cart.filter(x=>x.key!==key);updateCartCount();renderCart();}
function changeQty(key,delta){
  const item=cart.find(x=>x.key===key);
  if(item){item.qty+=delta;if(item.qty<=0)removeFromCart(key);else renderCart();}
  updateCartCount();
}
function updateCartCount(){
  const total=cart.reduce((s,i)=>s+i.qty,0);
  const badge=document.getElementById('cart-count');
  badge.textContent=total;badge.style.display=total>0?'flex':'none';
}
function renderCart(){
  const list=document.getElementById('cart-items-list');
  const footer=document.getElementById('cart-footer');
  const checkoutBar=document.getElementById('cart-checkout-bar');
  const count=document.getElementById('cart-item-count');
  if(!cart.length){
    list.innerHTML='<div class="cart-empty"><i class="ti ti-shopping-bag" style="font-size:3rem;display:block;margin-bottom:.75rem;opacity:.2"></i>Your cart is empty</div>';
    footer.style.display='none';
    checkoutBar.style.display='none';
    count.textContent='';
    return;
  }
  count.textContent=`(${cart.reduce((s,i)=>s+i.qty,0)} items)`;
  const total=cart.reduce((s,i)=>s+i.price*i.qty,0);
  list.innerHTML=cart.map(item=>`
    <div class="cart-item">
      <div class="cart-item-img">${item.image?`<img src="${item.image}" alt="${item.name}">`:item.emoji}</div>
      <div class="cart-item-info">
        <div class="cart-item-name">${item.name}${item.variant?' — '+item.variant:''}</div>
        <div class="cart-item-price">$${item.price.toFixed(2)} each</div>
        <div class="cart-qty">
          <button class="qty-btn" onclick="changeQty('${item.key}',-1)">−</button>
          <span class="qty-num">${item.qty}</span>
          <button class="qty-btn" onclick="changeQty('${item.key}',1)">+</button>
          <button style="margin-left:auto;background:none;border:none;color:var(--muted);cursor:pointer;font-size:18px;padding:4px 8px" onclick="removeFromCart('${item.key}')"><i class="ti ti-trash"></i></button>
        </div>
      </div>
    </div>
  `).join('');
  document.getElementById('cart-total').textContent='$'+total.toFixed(2);
  document.getElementById('cart-total-btn').textContent='$'+total.toFixed(2);
  footer.style.display='block';
  checkoutBar.style.display='block';
  document.getElementById('payment-error').style.display='none';
}

// ── CARD FORMAT HELPERS ──
function formatCard(input){
  let v=input.value.replace(/\D/g,'').substring(0,16);
  input.value=v.replace(/(.{4})/g,'$1 ').trim();
}
function formatExp(input){
  let v=input.value.replace(/\D/g,'');
  if(v.length>=2)v=v.substring(0,2)+' / '+v.substring(2,4);
  input.value=v;
}
function showPaymentError(msg){
  const el=document.getElementById('payment-error');
  document.getElementById('payment-error-msg').textContent=msg;
  el.style.display='flex';
  el.scrollIntoView({behavior:'smooth',block:'nearest'});
}
function luhn(n){
  let s=0,alt=false;
  for(let i=n.length-1;i>=0;i--){let d=parseInt(n[i]);if(alt){d*=2;if(d>9)d-=9;}s+=d;alt=!alt;}
  return s%10===0;
}
function fieldErr(id){document.getElementById(id).classList.add('error');}
function clearErrors(){
  document.querySelectorAll('.shipping-form input,.shipping-form select,.card-form input').forEach(i=>i.classList.remove('error'));
  document.getElementById('payment-error').style.display='none';
}

// ── CHECKOUT ──
async function checkout(){
  clearErrors();
  const shFirst=document.getElementById('sh-first').value.trim();
  const shLast=document.getElementById('sh-last').value.trim();
  const shStreet=document.getElementById('sh-street').value.trim();
  const shCity=document.getElementById('sh-city').value.trim();
  const shState=document.getElementById('sh-state').value.trim();
  const shZip=document.getElementById('sh-zip').value.trim();
  const shCountry=document.getElementById('sh-country').value.trim();
  const shPhone=document.getElementById('sh-phone').value.trim();
  const shEmail=document.getElementById('sh-email').value.trim();
  if(!shFirst){fieldErr('sh-first');showPaymentError('First name is required for shipping.');return;}
  if(!shLast){fieldErr('sh-last');showPaymentError('Last name is required for shipping.');return;}
  if(!shStreet){fieldErr('sh-street');showPaymentError('Street address is required so we can ship your order.');return;}
  if(!shCity){fieldErr('sh-city');showPaymentError('City is required.');return;}
  if(!shState){fieldErr('sh-state');showPaymentError('State is required.');return;}
  if(!shZip){fieldErr('sh-zip');showPaymentError('ZIP code is required.');return;}
  if(!shCountry){fieldErr('sh-country');showPaymentError('Country is required.');return;}
  if(!shPhone){fieldErr('sh-phone');showPaymentError('Phone number is required in case we need to contact you about your shipment.');return;}
  if(!shEmail||!shEmail.includes('@')){fieldErr('sh-email');showPaymentError('A valid email address is required for your order confirmation.');return;}
  const name=document.getElementById('cc-name').value.trim();
  const numRaw=document.getElementById('cc-num').value.replace(/\s/g,'');
  const exp=document.getElementById('cc-exp').value.trim();
  const cvv=document.getElementById('cc-cvv').value.trim();
  if(!name){fieldErr('cc-name');showPaymentError('Cardholder name is required.');return;}
  if(!numRaw||numRaw.length<15){fieldErr('cc-num');showPaymentError('Please enter a valid card number (15–16 digits).');return;}
  if(!exp||exp.replace(/\s/g,'').length<5){fieldErr('cc-exp');showPaymentError('Please enter your card expiry date (MM / YY).');return;}
  if(cvv.length<3){fieldErr('cc-cvv');showPaymentError('CVV must be 3–4 digits.');return;}
  if(!luhn(numRaw)){fieldErr('cc-num');showPaymentError('Card number is invalid. Please check and re-enter.');return;}
  const parts=exp.replace(/\s/g,'').split('/');
  if(parts.length<2){fieldErr('cc-exp');showPaymentError('Expiry format should be MM / YY.');return;}
  const mm=parseInt(parts[0]),yy=parseInt(parts[1]);
  if(isNaN(mm)||isNaN(yy)||mm<1||mm>12){fieldErr('cc-exp');showPaymentError('Invalid expiry month.');return;}
  const now=new Date(),cy=now.getFullYear()%100,cm=now.getMonth()+1;
  if(yy<cy||(yy===cy&&mm<cm)){fieldErr('cc-exp');showPaymentError('Your card has expired. Please use a valid card.');return;}
  const total=cart.reduce((s,i)=>s+i.price*i.qty,0);
  const orderId=`ORD-${1000+store.orders.length+1}`;
  const shippingAddress={name:`${shFirst} ${shLast}`,street:shStreet,apt:document.getElementById('sh-apt').value.trim(),city:shCity,state:shState,zip:shZip,country:shCountry,phone:shPhone,email:shEmail};
  const order={id:orderId,date:new Date().toLocaleDateString(),customer:`${shFirst} ${shLast}`,email:shEmail,phone:shPhone,shippingAddress,items:cart.map(i=>i.name),total:total.toFixed(2),status:'pending',paid:true,payMethod:'card',cardLast4:numRaw.slice(-4)};
  store.orders.unshift(order);
  const existingCust=store.customers.find(c=>c.email===shEmail);
  if(existingCust){existingCust.orders++;existingCust.spent=+(existingCust.spent+total).toFixed(2);}
  else store.customers.push({name:`${shFirst} ${shLast}`,email:shEmail,orders:1,spent:+total.toFixed(2),joined:new Date().toLocaleDateString()});
  await saveStoreData();
  cart=[];updateCartCount();renderCart();closeCart();
  ['sh-first','sh-last','sh-street','sh-apt','sh-city','sh-state','sh-zip','sh-phone','sh-email'].forEach(id=>{const el=document.getElementById(id);if(el)el.value='';});
  document.getElementById('sh-country').value='United States';
  ['cc-name','cc-num','cc-exp','cc-cvv'].forEach(id=>{const el=document.getElementById(id);if(el)el.value='';});
  showToast(`Payment accepted! Order ${orderId} confirmed. 🎉`,4000);
}


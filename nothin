// ── PERSISTENCE: tries window.storage (Claude artifact) first, falls back to localStorage ──
async function loadStore(){
  let saved=null;
  // Try artifact persistent storage first
  if(window.storage){
    try{
      const result=await window.storage.get(STORAGE_KEY);
      if(result)saved=result.value;
    }catch(e){/* key doesn't exist yet */}
  }
  // Fall back to localStorage
  if(!saved){
    try{saved=localStorage.getItem(STORAGE_KEY);}catch(e){}
  }
  if(saved){
    try{
      const parsed=JSON.parse(saved);
      store=parsed;
    }catch(e){console.error('Failed to parse store data',e);}
  }
  // Ensure all required arrays/objects exist
  if(!store.products)store.products=[];
  if(!store.orders)store.orders=[];
  if(!store.customers)store.customers=[];
  if(!store.discounts)store.discounts=[];
  if(!store.theme)store.theme={bg:'#FFFFFF',accent:'#0A0A0A',headingFont:"'Playfair Display',serif",bodyFont:"'DM Sans',sans-serif"};
  if(!store.payoutInfo)store.payoutInfo={bank:'',email:'',cashapp:'',notes:''};
  if(!store.settings)store.settings={announcement:'Free shipping on orders over $75 · Use code WELCOME10 for 10% off',barColor:'#0A0A0A',storeName:'ShopForge',tagline:'Curated for everyday living',subtitle:'Premium goods, thoughtfully selected for modern life'};
}

async function saveStoreData(){
  const data=JSON.stringify(store);
  // Save to artifact persistent storage if available
  if(window.storage){
    try{await window.storage.set(STORAGE_KEY,data);}catch(e){console.error('Artifact storage save failed',e);}
  }
  // Also save to localStorage as backup
  try{localStorage.setItem(STORAGE_KEY,data);}catch(e){}
  // Show save indicator
  const ind=document.getElementById('save-indicator');
  if(ind){
    ind.classList.add('show');
    clearTimeout(saveIndicatorTimer);
    saveIndicatorTimer=setTimeout(()=>ind.classList.remove('show'),2000);
  }
}


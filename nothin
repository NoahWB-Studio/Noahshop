  if(!q){res.innerHTML='<p style="font-size:12px;color:var(--muted);padding:.5rem .25rem;display:flex;align-items:center;gap:6px"><i class="ti ti-keyboard" style="font-size:15px"></i> Start typing to search products…</p>';return;}
